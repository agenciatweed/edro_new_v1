---
/* =============================================================
   EDRO · Layout base v3.1
   Menu de 7 itens, logo horizontal oficial (brand/), rodapé com
   CNPJ e CEP 88708-270, botão flutuante "Falar no WhatsApp" em
   todas as telas (desktop) e barra fixa no celular.
   ============================================================= */

import { Image } from 'astro:assets';
import { bikes, wa, comercial, digitos, telefoneBr } from '../lib/edro.js';
import { img } from '../lib/imagens.js';

import '../styles/tokens.css';
import '../styles/edro.css';
import '../styles/v3.css';

const {
  titulo: tituloPagina,
  descricao,
  canonica = 'https://edrobikes.com.br/',
  jsonLd,
  pagina = 'home',
  noindex = false,
} = Astro.props;

const rota = Astro.url.pathname;
const rotaLimpa = rota.replace(/\/$/, '') || '/';
const ativoEm = (href) => rotaLimpa === href || rotaLimpa.startsWith(href + '/');

const menu = [
  { rotulo: 'Bikes',           href: '/bikes' },
  { rotulo: 'Bikes elétricas', href: '/horizon' },
  { rotulo: 'FIT4U',           href: '/fit4u' },
  { rotulo: 'Programas',       href: '/programas' },
  { rotulo: 'Engenharia',      href: '/engenharia' },
  { rotulo: 'Parcerias',       href: '/parcerias' },
  { rotulo: 'A marca',         href: '/a-marca' },
];

const rodape = [
  { titulo: 'Bikes', links: [['SUMMA', '/bikes/summa'], ['RANGE', '/bikes/range'], ['IMPETUS', '/bikes/impetus']] },
  { titulo: 'Bikes elétricas', links: [['HORIZON', '/horizon'], ['SUMMA HORIZON', '/horizon/summa-horizon'], ['RANGE HORIZON', '/horizon/range-horizon'], ['Simulador de autonomia', '/horizon/simulador']] },
  { titulo: 'Programas', links: [['FIT4U', '/fit4u'], ['Compra Certa', '/programas/compra-certa'], ['Ciclo EDRO', '/programas/ciclo-edro'], ['Carbon Assist', '/programas/carbon-assist'], ['Garantia Vitalícia', '/programas/garantia']] },
  { titulo: 'EDRO', links: [['A marca', '/a-marca'], ['Engenharia', '/engenharia'], ['Parcerias', '/parcerias'], ['Guias', '/guias'], ['Dúvidas frequentes', '/faq'], ['Contato', '/contato']] },
];

const ct = bikes.contato;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'EDRO Performance Bikes',
  legalName: ct.razao_social,
  taxID: ct.cnpj,
  url: 'https://edrobikes.com.br',
  logo: 'https://edrobikes.com.br/logo-edro.png',
  email: ct.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Rua Rubens Faraco, 274', postalCode: '88708-270', addressLocality: 'Tubarão', addressRegion: 'SC', addressCountry: 'BR' },
  sameAs: ['https://www.instagram.com/edrobikes/', 'https://www.youtube.com/@edrobikes'],
};

/* BreadcrumbList a partir da rota */
const NOMES = { bikes: 'Bikes', horizon: 'Bikes elétricas', programas: 'Programas', summa: 'SUMMA', range: 'RANGE', impetus: 'IMPETUS',
  'summa-horizon': 'SUMMA HORIZON', 'range-horizon': 'RANGE HORIZON', simulador: 'Simulador de autonomia', 'compra-certa': 'Compra Certa',
  'ciclo-edro': 'Ciclo EDRO', 'carbon-assist': 'Carbon Assist', garantia: 'Garantia Vitalícia', fit4u: 'FIT4U', engenharia: 'Engenharia',
  'a-marca': 'A marca', parcerias: 'Parcerias', contato: 'Contato', faq: 'Dúvidas frequentes', guias: 'Guias', politicas: 'Políticas' };
const partes = rotaLimpa.split('/').filter(Boolean);
const trilha = partes.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://edrobikes.com.br/' },
    ...partes.map((s, i) => ({ '@type': 'ListItem', position: i + 2, name: NOMES[s] ?? s, item: `https://edrobikes.com.br/${partes.slice(0, i + 1).join('/')}` }))],
} : null;

const whatsSvg = 'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.17c-.25.69-1.44 1.32-1.99 1.36-.53.04-1.02.22-3.44-.72-2.9-1.14-4.73-4.1-4.87-4.29-.14-.19-1.16-1.55-1.16-2.95 0-1.4.73-2.09.99-2.37.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.25.6.83 2.07.9 2.22.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.07.95 1.97 1.25 2.25 1.39.28.14.44.12.6-.07.16-.19.69-.81.88-1.08.19-.28.37-.23.63-.14.25.09 1.61.76 1.89.9.28.14.46.21.53.32.07.12.07.67-.18 1.36Z';
const msgPadrao = 'Olá, EDRO. Quero falar com um dos especialistas. (origem: site-flutuante)';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloPagina}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonica} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/png" href="/favicon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="EDRO Performance Bikes" />
  <meta property="og:title" content={tituloPagina} />
  <meta property="og:description" content={descricao} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:image" content="https://edrobikes.com.br/og-edro.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@700&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,500&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {trilha && <script type="application/ld+json" set:html={JSON.stringify(trilha)} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <slot name="head" />
</head>

<body data-pagina={pagina}>

<a class="pular" href="#conteudo">Pular para o conteúdo</a>

<header class="nav">
  <div class="nav__interno">
    <a class="nav__logo" href="/" aria-label="EDRO Performance Bikes, página inicial">
      <Image src={img('brand/logo-horizontal-branco.png')} alt="EDRO Performance Bikes" height={46} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav__menu" aria-label="Navegação principal">
      {menu.map((m) => (
        <a class:list={['nav__link', { ativo: ativoEm(m.href) }]} href={m.href} aria-current={ativoEm(m.href) ? 'page' : undefined}>{m.rotulo}</a>
      ))}
    </nav>

    <div class="nav__acoes">
      <a class="nav__falar" href="/contato">Falar com a EDRO</a>
      <a class="btn btn--primario nav__btn" href={wa('Olá, EDRO. Quero montar a minha EDRO. (origem: site-nav)')} rel="noopener" data-wa="nav">Monte a sua</a>
    </div>

    <button class="nav__hamburguer" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Abrir menu">
      <span class="nav__barra" aria-hidden="true"></span>
      <span class="nav__barra" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="menu-mobile" id="menu-mobile" hidden>
  <nav class="menu-mobile__lista" aria-label="Navegação mobile">
    {menu.map((m) => <a href={m.href}>{m.rotulo}</a>)}
    <span class="menu-mobile__divisor" aria-hidden="true"></span>
    <div class="menu-mobile__rodape">
      <a href={`https://wa.me/${comercial}`} rel="noopener">Comercial {telefoneBr(ct.whatsapp_comercial)}</a>
      <a href={`https://wa.me/${digitos(ct.whatsapp_suporte)}`} rel="noopener">Suporte {telefoneBr(ct.whatsapp_suporte)}</a>
      <a href={`mailto:${ct.email}`}>{ct.email}</a>
      <p>{ct.horario}</p>
    </div>
  </nav>
</div>

<main id="conteudo">
  <slot />
</main>

<footer class="rodape">
  <div class="container">
    <div class="rodape__grade">
      <div class="rodape__marca">
        <Image src={img('brand/logo-vertical-branco.png')} alt="EDRO Performance Bikes" height={56} densities={[1, 2]} loading="lazy" />
        <p>{ct.razao_social}</p>
        <p>CNPJ {ct.cnpj}</p>
        <p>{ct.endereco}</p>
        <p>{ct.horario}</p>
      </div>
      {rodape.map((c) => (
        <nav class="rodape__coluna" aria-label={c.titulo}>
          <h2 class="eyebrow">{c.titulo}</h2>
          {c.links.map(([t, h]) => <a href={h}>{t}</a>)}
        </nav>
      ))}
    </div>

    <div class="rodape__legal">
      <p>© 2026 EDRO Performance Bikes. <a href="/politicas">Políticas</a> · <a href="/politicas#privacidade">Privacidade e LGPD</a></p>
      <p>edrobikes.com.br · <a href="https://www.instagram.com/edrobikes/" rel="noopener">@edrobikes</a> · #DeSCParaOMundo</p>
    </div>
  </div>
</footer>

<a class="whatsapp-flutuante" href={wa(msgPadrao)} rel="noopener" data-wa="flutuante">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={whatsSvg} /></svg>
  Falar no WhatsApp
</a>
<a class="whatsapp-fixo" href={wa(msgPadrao.replace('site-flutuante', 'site-barra'))} rel="noopener" data-wa="barra">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={whatsSvg} /></svg>
  Falar no WhatsApp
</a>

<script>
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const podeAnimar = 'IntersectionObserver' in window && !reduzir;

  /* Barra fixa do celular recolhe enquanto os botões do hero estão na tela. */
  const barra = document.querySelector('.whatsapp-fixo');
  const gatilho = document.querySelector('[data-esconde-barra]');
  if (barra && gatilho && 'IntersectionObserver' in window) {
    const recolher = (sim) => barra.classList.toggle('recolhida', sim);
    const r = gatilho.getBoundingClientRect();
    recolher(r.bottom > 0 && r.top < window.innerHeight);
    new IntersectionObserver((e) => recolher(e[0].isIntersecting)).observe(gatilho);
  }

  /* Evento de analytics em todo botão de WhatsApp */
  document.querySelectorAll('[data-wa]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'whatsapp_click', origem: el.getAttribute('data-wa'), pagina: document.body.dataset.pagina || 'home' });
    });
  });

  /* Lite embed do YouTube: o player só existe depois do clique. */
  document.querySelectorAll('[data-yt]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.getAttribute('data-yt');
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = el.getAttribute('data-yt-titulo') || 'Vídeo EDRO';
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      el.replaceChildren(f);
    }, { once: true });
  });

  /* Menu mobile */
  const botao = document.querySelector('.nav__hamburguer');
  const painel = document.getElementById('menu-mobile');
  if (botao && painel) {
    const fechar = () => { botao.setAttribute('aria-expanded', 'false'); botao.setAttribute('aria-label', 'Abrir menu'); painel.hidden = true; document.body.style.overflow = ''; };
    const abrir = () => { botao.setAttribute('aria-expanded', 'true'); botao.setAttribute('aria-label', 'Fechar menu'); painel.hidden = false; document.body.style.overflow = 'hidden'; };
    botao.addEventListener('click', () => (botao.getAttribute('aria-expanded') === 'true' ? fechar() : abrir()));
    painel.addEventListener('click', (e) => { if (e.target instanceof HTMLAnchorElement) fechar(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && botao.getAttribute('aria-expanded') === 'true') { fechar(); botao.focus(); } });
    window.addEventListener('resize', () => { if (window.innerWidth > 899 && botao.getAttribute('aria-expanded') === 'true') fechar(); });
  }

  /* Entrada das seções, 60 ms entre filhos, uma vez */
  if (podeAnimar) {
    document.documentElement.classList.add('js-anim');
    const grupos = document.querySelectorAll('.cabecalho, .linhas__grade, .numeros4, .selos, .galeria3, .pilares, .tec4, .prova-num, .fechamento__interno, .guias, .caminhos3, .atletas');
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((en) => {
        if (!en.isIntersecting) return;
        Array.from(en.target.children).forEach((f, i) => setTimeout(() => f.classList.add('visivel'), i * 60));
        obs.unobserve(en.target);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });
    grupos.forEach((g) => { Array.from(g.children).forEach((f) => f.classList.add('revelar')); obs.observe(g); });
  }
</script>

</body>
</html>
