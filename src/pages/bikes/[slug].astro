---
/* Páginas de linha v3.1 · telas site_v3/03, 04 e 05. Mesmo template para SUMMA, RANGE e IMPETUS. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SeletorVersoes from '../../components/SeletorVersoes.astro';
import Numeros from '../../components/Numeros.astro';
import Midia from '../../components/Midia.astro';
import Pilares from '../../components/Pilares.astro';
import Geometria from '../../components/Geometria.astro';
import Fechamento from '../../components/Fechamento.astro';
import { bikes, plataformas, brl, kg, wa } from '../../lib/edro.js';
import { videos } from '../../lib/imagens.js';

export function getStaticPaths() {
  return ['summa', 'range', 'impetus'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = plataformas.find((x) => x.slug === slug);

/* Bloco de vídeo real depois das versões. A SUMMA tem o review do atleta
   (tela 03). RANGE e IMPETUS recebem o vídeo que a v3.1 manda usar no banner:
   no banner ele depende do corte mudo de 12 s; aqui entra inteiro, em lite embed. */
const VIDEO = {
  summa: { eyebrow: 'Quem pedala, conta', linhas: ['A SUMMA vista por', 'quem'], verde: ' compete.', texto: 'Matheus Miranda, atleta patrocinado pela EDRO, sobre a nova SUMMA. Sem roteiro.', video: videos.review, legenda: 'Vídeo já publicado no YouTube.' },
  range: { eyebrow: 'Veja na prática', linhas: ['Terreno difícil,'], verde: 'desempenho real.', texto: 'A RANGE onde ela foi pensada para estar: trilha técnica, raiz, pedra e subida com o grupo. Vídeo real, sem roteiro de publicidade.', video: videos.range },
  impetus: { eyebrow: 'Veja na prática', linhas: ['A única bike de', 'estrada que você', 'vai'], verde: ' precisar.', texto: 'Plano, serra e longa distância com o mesmo quadro. Vídeo real, sem roteiro de publicidade.', video: videos.impetus },
}[slug];

const produto = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: `EDRO ${p.nome}`,
  description: `${p.beneficio_titulo} ${p.beneficio}`,
  brand: { '@type': 'Brand', name: 'EDRO Performance Bikes' },
  category: p.categoria,
  productGroupID: `edro-${p.slug}`,
  variesBy: 'https://schema.org/model',
  hasVariant: p.versoes.map((v) => ({
    '@type': 'Product',
    name: `EDRO ${p.nome} ${v.nome}`,
    description: v.resumo,
    image: 'https://edrobikes.com.br/og-edro.png',
    weight: { '@type': 'QuantitativeValue', value: v.peso_kg, unitCode: 'KGM' },
    offers: { '@type': 'Offer', price: v.preco, priceCurrency: 'BRL', availability: 'https://schema.org/PreOrder', url: `https://edrobikes.com.br/bikes/${p.slug}#${v.slug}` },
  })),
};

const TITULOS = {
  summa: 'EDRO SUMMA · Mountain bike hardtail XC de carbono sob medida',
  range: 'EDRO RANGE · Mountain bike full suspension XC de carbono sob medida',
  impetus: 'EDRO IMPETUS · Bicicleta speed aero de carbono sob medida',
};
const H1 = {
  summa: 'EDRO SUMMA, mountain bike hardtail XC de carbono',
  range: 'EDRO RANGE, mountain bike full suspension XC de carbono',
  impetus: 'EDRO IMPETUS, bicicleta speed aero de carbono',
};
const menor = Math.min(...p.versoes.map((v) => v.preco));
const tituloVideo = VIDEO.linhas.join('<br />') + (VIDEO.verde.startsWith(' ') ? ' ' : '<br />') + `<span class="verde">${VIDEO.verde.trim()}</span>`;
---

<Base
  titulo={TITULOS[slug]}
  descricao={`${p.nome} ${p.pro.nome} com ${kg(p.pro.peso_kg)} kg sem pedais. ${p.beneficio_titulo} Carbono, feita à mão em Tubarão, a partir de ${brl(menor)}.`}
  canonica={`https://edrobikes.com.br/bikes/${p.slug}`}
  pagina={p.slug}
  jsonLd={produto}
>

<Hero
  classe="hero3--foto-lado"
  eyebrow={p.uso_curto}
  wordmark={`brand/${p.slug}.png`}
  h1Oculto={H1[slug]}
  lead={p.hero_frase}
  botoes={[
    { rotulo: `Monte a sua ${p.nome}`, href: wa(`Olá, EDRO. Quero montar a minha ${p.nome}. (origem: site-${p.slug})`), primario: true, wa: `hero-${p.slug}` },
    { rotulo: 'Ver versões', href: '#versoes' },
  ]}
  fundo={{ src: `lp/bike-${p.slug}.jpg`, alt: `EDRO ${p.nome} de carbono em estrada ao entardecer`, posicao: '65% center' }}
  peso={{ valor: kg(p.pro.peso_kg), rotulo: `<i class="modelo">${p.nome}</i> <span class="verde">${p.pro.nome}</span>, sem pedais<br />Versões a partir de ${brl(menor)}` }}
/>

<SeletorVersoes linha={p} wordmark={p.slug} notaPeso={bikes.meta.nota_peso} rotuloGrupos={bikes.meta.grupos_ficha} />

<section class="secao">
  <div class="container bloco2">
    <div>
      <p class="eyebrow eyebrow--verde">{VIDEO.eyebrow}</p>
      <h2 class="headline" style="margin-top:var(--s-4)" set:html={tituloVideo} />
      <p class="lead">{VIDEO.texto}</p>
    </div>
    <Midia video={VIDEO.video} proporcao="16x9" legenda={VIDEO.legenda} sizes="(max-width: 1023px) 100vw, 50vw" />
  </div>
</section>

<Numeros itens={p.numeros} />

<section class="secao secao--sem-linha" style="padding-top:0">
  <div class="container galeria3">
    {p.macros.map(([t, d]) => <Midia titulo={t} descricao={d} />)}
  </div>
</section>

<Pilares />

<Geometria p={p} />

<Fechamento linhas={['Fuja do']} verde="comum."
  texto={`Fale com um dos nossos especialistas sobre a sua <i class="modelo">${p.nome}</i>.`}
  botoes={[
    { rotulo: 'Falar com um especialista', href: wa(`Olá, EDRO. Quero falar com um especialista sobre a ${p.nome}. (origem: site-${p.slug}-fechamento)`), primario: true, wa: `fechamento-${p.slug}` },
    { rotulo: 'Ver as outras linhas', href: '/bikes' },
  ]} />

</Base>
