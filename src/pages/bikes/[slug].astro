---
/* =============================================================
   Páginas de linha v3.3 (§8): só a parte técnica do quadro.
   Hero em carrossel de fotos escurecidas, argumentos de engenharia,
   o quadro (fundo branco), construção EDRO, vídeo, geometria em grade
   e, no fim, os modelos em cards brancos. Preço, ficha e condições
   ficam nas páginas de modelo (/bikes/<linha>/<versao>).
   ============================================================= */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Midia from '../../components/Midia.astro';
import ConstrucaoEdro from '../../components/ConstrucaoEdro.astro';
import GeometriaGrade from '../../components/GeometriaGrade.astro';
import CardModelo from '../../components/CardModelo.astro';
import { Picture } from 'astro:assets';
import fundos from '../../content/fundos.json';
import { plataformas, brl, personalizar, rodapeFicha } from '../../lib/edro.js';
import { img, videos } from '../../lib/imagens.js';

export function getStaticPaths() {
  return ['summa', 'range', 'impetus'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = plataformas.find((x) => x.slug === slug);
const modelo = (s) => s.replace(/\b(SUMMA|RANGE|IMPETUS)\b/g, '<i class="modelo">$1</i>');

/* Vídeo da linha, até chegarem os Shorts (TODO(EDRO): IDs dos YouTube Shorts de cada linha, §8.6). */
const VIDEO = {
  summa: { titulo: ['A SUMMA vista por', 'quem'], verde: ' compete.', texto: 'Matheus Miranda, atleta patrocinado pela EDRO, sobre a nova SUMMA. Sem roteiro.', video: videos.review },
  range: { titulo: ['Terreno difícil,'], verde: 'desempenho real.', texto: 'A RANGE onde ela foi pensada para estar: trilha técnica, raiz, pedra e subida com o grupo.', video: videos.range },
  impetus: { titulo: ['A única bike de', 'estrada que você', 'vai'], verde: ' precisar.', texto: 'Plano, serra e longa distância com o mesmo quadro.', video: videos.impetus },
}[slug];
const tituloVideo = VIDEO.titulo.join('<br />') + (VIDEO.verde.startsWith(' ') ? ' ' : '<br />') + `<span class="verde">${VIDEO.verde.trim()}</span>`;

/* Fotos de detalhe ao lado dos argumentos; a IMPETUS ainda não tem macros (ficam os espaços de produção). */
const fotosArg = p.fotos_argumentos.length ? p.fotos_argumentos.map(([src, alt]) => ({ src, alt })) : p.macros.slice(0, 2).map(([titulo, descricao]) => ({ titulo, descricao }));

const produto = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: `EDRO ${p.nome}`,
  description: `${p.para_quem}.`,
  brand: { '@type': 'Brand', name: 'EDRO Performance Bikes' },
  category: p.tipo,
  productGroupID: `edro-${p.slug}`,
  variesBy: 'https://schema.org/model',
  hasVariant: p.versoes.map((v) => ({
    '@type': 'Product',
    name: `EDRO ${p.nome} ${v.nome}`,
    description: v.resumo,
    sku: v.chave,
    image: 'https://edrobikes.com.br/og-edro.png',
    weight: { '@type': 'QuantitativeValue', value: v.peso_kg, unitCode: 'KGM' },
    offers: { '@type': 'Offer', price: v.preco, priceCurrency: 'BRL', availability: 'https://schema.org/PreOrder', url: `https://edrobikes.com.br/bikes/${p.slug}/${v.slug}` },
  })),
};
const TITULOS = {
  summa: 'EDRO SUMMA · Mountain bike hardtail XC de carbono sob medida',
  range: 'EDRO RANGE · Mountain bike full suspension XC de carbono sob medida',
  impetus: 'EDRO IMPETUS · Road bike de carbono sob medida',
};
const H1 = {
  summa: 'EDRO SUMMA, mountain bike hardtail XC de carbono',
  range: 'EDRO RANGE, mountain bike full suspension XC de carbono',
  impetus: 'EDRO IMPETUS, road bike de carbono',
};
const menor = Math.min(...p.versoes.map((v) => v.preco));
const versoesJs = JSON.stringify(p.versoes.map((v) => v.slug));
---

<Base
  titulo={TITULOS[slug]}
  descricao={`${p.nome}: ${p.para_quem}. Carbono monocoque, feita à mão em Tubarão, a partir de ${brl(menor)}.`}
  canonica={`https://edrobikes.com.br/bikes/${p.slug}`}
  pagina={p.slug}
  jsonLd={produto}
>
  {/* Links antigos de anúncio (/bikes/summa#xcr) vão para a página do modelo. */}
  <script slot="head" is:inline define:vars={{ versoes: JSON.parse(versoesJs), linha: p.slug }}>
    var h = decodeURIComponent(location.hash.slice(1)).toLowerCase();
    if (versoes.indexOf(h) !== -1) location.replace('/bikes/' + linha + '/' + h);
  </script>

<Hero
  eyebrow={p.tipo}
  vt={p.slug}
  wordmark={`brand/${p.slug}.png`}
  h1Oculto={H1[slug]}
  lead={p.hero_texto}
  botoes={[
    { rotulo: 'Ver modelos', href: '#modelos', primario: true },
    { rotulo: 'Pinte a sua', href: personalizar(p.pro.chave) },
  ]}
  fotos={fundos[slug]}
/>

<!-- Argumentos de engenharia (§8.3) -->
<section class="secao secao--sem-linha eng-args">
  <div class="container eng-args__grade">
    <div class="eng-args__lista">
      {p.argumentos.map((a) => (
        <article class="eng-arg">
          <p class="eng-arg__numero" aria-hidden="true">{a.numero}</p>
          <h2 class="eng-arg__titulo">{a.titulo}</h2>
          <p class="eng-arg__texto" set:html={a.texto} />
        </article>
      ))}
    </div>
    <div class="eng-args__fotos">
      {fotosArg.map((f) => <Midia src={f.src} alt={f.alt} titulo={f.titulo} descricao={f.descricao} proporcao="4x5" sizes="(max-width: 1023px) 100vw, 40vw" />)}
    </div>
  </div>
</section>

<!-- O quadro (§8.4): fundo branco, porque mostra a bike -->
<section class="secao secao--clara quadro">
  <div class="container">
    <div class="quadro__linha">
      <figure class="quadro__foto">
        <Picture src={img(p.pro.foto)} formats={['avif', 'webp']} alt={`EDRO ${p.nome} PRO 2027, vista lateral`} widths={[800, 1400]} sizes="(max-width: 1023px) 100vw, 55vw" loading="lazy" />
        <figcaption>{p.quadro.titulo}</figcaption>
      </figure>
      <div class="quadro__texto">
        <h2 class="headline headline--media">{p.quadro.titulo}</h2>
        {p.quadro.textos.map((t) => <p set:html={modelo(t)} />)}
      </div>
    </div>
    <div class="quadro__linha quadro__linha--ambiente">
      <figure class="quadro__ambiente">
        <Picture src={img(p.quadro.foto_ambiente[0])} formats={['avif', 'webp']} alt={p.quadro.foto_ambiente[1]} widths={[640, 1000]} sizes="(max-width: 1023px) 100vw, 45vw" loading="lazy" />
      </figure>
      <div class="quadro__texto">
        {p.quadro.fecho.map((t) => <p set:html={modelo(t)} />)}
      </div>
    </div>
  </div>
</section>

<ConstrucaoEdro />

<!-- Vídeo da linha (§8.6: os Shorts entram quando a EDRO enviar os IDs) -->
<section class="secao">
  <div class="container bloco2">
    <div>
      <h2 class="headline" set:html={tituloVideo} />
      <p class="lead" set:html={modelo(VIDEO.texto)} />
    </div>
    <Midia video={VIDEO.video} proporcao="16x9" sizes="(max-width: 1023px) 100vw, 50vw" />
  </div>
</section>

<GeometriaGrade p={p} />

<!-- Modelos (§8.7) -->
<section class="secao secao--clara" id="modelos">
  <div class="container">
    <h2 class="headline">Escolha a sua <i class="modelo">{p.nome}</i>.</h2>
    <div class="modelos-linha">
      {p.versoes.map((v) => <CardModelo linha={p} versao={v} />)}
    </div>
    <p class="nota-peso">{rodapeFicha.join(' ')}</p>
  </div>
</section>

</Base>
