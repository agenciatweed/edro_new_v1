---
/* Página de modelo (linhas convencionais): o conteúdo está em components/PaginaModelo.astro. */
import PaginaModelo from '../../../components/PaginaModelo.astro';
import { plataformas } from '../../../lib/edro.js';

export function getStaticPaths() {
  return plataformas.flatMap((p) => p.versoes.map((v) => ({ params: { linha: p.slug, versao: v.slug }, props: { p, v } })));
}

const { p, v } = Astro.props;
---
<PaginaModelo p={p} v={v} />
