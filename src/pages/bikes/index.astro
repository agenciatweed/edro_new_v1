---
import Base from '../../layouts/Base.astro';
import CardPlataforma from '../../components/CardPlataforma.astro';
import { bikes, plataformas, brl, kg, wa } from '../../lib/edro.js';

/* =============================================================
   Comparativo do capítulo 30, calculado do bikes.json.
   Ângulos, chainstay, reach e stack saem da tabela de geometria,
   localizados pelo nome da coluna na legenda. Se a coluna sumir,
   o build falha em vez de publicar célula vazia ou número errado.
   ============================================================= */

const numero = (v) =>
  typeof v === 'number' ? v : parseFloat(String(v).replace('°', '').replace(',', '.'));

const pt = (n) => String(Math.round(n * 10) / 10).replace('.', ',');

function indicePorLegenda(p, rotulo) {
  const g = p.geometria;
  const col = g.colunas.find((c) => (g.legenda?.[c] || '').toLowerCase() === rotulo);
  if (!col) throw new Error(`/bikes: a ${p.nome} não tem a coluna "${rotulo}" na legenda da geometria.`);
  return g.colunas.indexOf(col);
}

function faixa(p, rotulo, unidade) {
  const i = indicePorLegenda(p, rotulo);
  const valores = p.tamanhos.filter((t) => Array.isArray(p.geometria[t])).map((t) => numero(p.geometria[t][i]));
  const min = Math.min(...valores);
  const max = Math.max(...valores);
  return min === max ? `${pt(min)}${unidade}` : `${pt(min)}${unidade} a ${pt(max)}${unidade}`;
}

function noTamanhoM(p, coluna, unidade) {
  const i = p.geometria.colunas.indexOf(coluna);
  if (i < 0 || !Array.isArray(p.geometria.M)) {
    throw new Error(`/bikes: a ${p.nome} não tem ${coluna} no tamanho M.`);
  }
  return `${pt(numero(p.geometria.M[i]))}${unidade}`;
}

function curso(p) {
  const { curso_garfo_mm: garfo, curso_traseiro_mm: traseiro } = p.quadro;
  if (garfo && traseiro) return `Garfo ${garfo} mm, traseiro ${traseiro} mm`;
  if (garfo) return `Garfo ${garfo} mm`;
  return 'Rígida';
}

const texto = (p, campo) => {
  const v = p.comparativo?.[campo];
  if (!v) throw new Error(`/bikes: a ${p.nome} não tem comparativo.${campo} no bikes.json.`);
  return v;
};

const linhas = [
  ['Categoria', (p) => texto(p, 'categoria')],
  ['Curso', curso],
  ['Tamanhos', (p) => p.tamanhos.join(', ')],
  ['Ângulo da caixa', (p) => faixa(p, 'ângulo da caixa', '°')],
  ['Ângulo do tubo de selim', (p) => faixa(p, 'ângulo do tubo de selim', '°')],
  ['Chainstay', (p) => faixa(p, 'chainstay', ' mm')],
  ['Reach no tamanho M', (p) => noTamanhoM(p, 'REACH', ' mm')],
  ['Stack no tamanho M', (p) => noTamanhoM(p, 'STACK', ' mm')],
  ['Eixos', (p) => texto(p, 'eixos')],
  ['Movimento central', (p) => texto(p, 'movimento_central')],
  ['Câmbio', (p) => texto(p, 'cambio')],
  ['Pneus', (p) => texto(p, 'pneus')],
  ['Peso da PRO no tamanho M', (p) => `${kg(p.pro.peso_kg)} kg`],
  ['Peso do quadro no tamanho M', (p) => (p.quadro.peso_quadro_g_M ? `cerca de ${p.quadro.peso_quadro_g_M} g` : 'não publicado')],
  ['Preço de tabela', (p) => {
    const precos = p.versoes.map((v) => v.preco);
    return `${brl(Math.min(...precos))} a ${brl(Math.max(...precos))}`;
  }],
  ['Versões', (p) => p.versoes.map((v) => v.nome).join(', ')],
];

const tabela = linhas.map(([rotulo, valor]) => ({ rotulo, celulas: plataformas.map(valor) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Plataformas EDRO',
  itemListElement: plataformas.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://edrobikes.com.br/bikes/${p.slug}`,
    name: `EDRO ${p.nome}`,
  })),
};
---

<Base
  titulo="Bikes EDRO · Três plataformas de carbono sob medida"
  descricao="SUMMA, RANGE e IMPETUS: três plataformas de carbono EDRO feitas sob medida em Tubarão, SC. Compare geometria, peso, versões e preço."
  canonica="https://edrobikes.com.br/bikes"
  pagina="bikes"
  jsonLd={jsonLd}
>

<!-- 17.1 · TOPO -->
<section class="pagina-topo">
  <div class="container cabecalho cabecalho--topo">
    <h1 class="display">Três plataformas.<br />Nenhuma bike igual.</h1>
    <p class="lead">
      Cada plataforma EDRO nasce de um molde exclusivo em carbono monocoque, com modelagem EPS
      e prepreg de alto módulo. A partir daí, geometria, cockpit, pintura e cada componente são
      definidos para uma única pessoa: você.
    </p>
  </div>
</section>

<!-- CARDS -->
<section class="secao secao--sem-linha secao--colada">
  <div class="container">
    <div class="plataformas__grade">
      {plataformas.map((p) => <CardPlataforma p={p} />)}
    </div>
    <p class="caption plataformas__nota">{bikes.meta.nota_legal}</p>
  </div>
</section>

<!-- 17.1 · COMO ESCOLHER -->
<section class="secao">
  <div class="container duas-colunas">
    <div>
      <h2 class="card-title">Como escolher.</h2>
      <p class="lead">
        Se a sua prova é XCO, maratona ou XCM com muita subida, comece pela <i class="modelo">SUMMA</i>.
        Se a trilha é técnica e você quer tração sem perder eficiência, a <i class="modelo">RANGE</i>.
        Se a estrada é o seu lugar, a <i class="modelo">IMPETUS</i> faz aero, escalada e longas
        distâncias no mesmo quadro.
      </p>
    </div>
    <div>
      <h2 class="card-title">O que muda entre as versões.</h2>
      <p class="lead">
        PRO leva o melhor que existe (SRAM XX SL ou RED AXS, RockShox Flight Attendant, rodas VORZ
        de topo) e o menor peso. XCR e SSR entregam o mesmo quadro com componentes eletrônicos de
        excelente nível. EX e SS são a porta de entrada para a plataforma, com o mesmo quadro, a
        mesma pintura exclusiva e a mesma garantia vitalícia.
      </p>
    </div>
  </div>
</section>

<!-- 30 · COMPARATIVO -->
<section class="secao">
  <div class="container">
    <div class="cabecalho">
      <h2 class="headline">Lado a<br />lado.</h2>
      <p class="lead">
        As três plataformas com os mesmos critérios. Cada número vem do arquivo de dados da EDRO.
      </p>
    </div>

    <div class="tabela-rolagem">
      <table class="tabela tabela--comparativo">
        <caption class="tabela__caption">Comparativo entre as plataformas EDRO</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            {plataformas.map((p) => (
              <th scope="col"><a href={`/bikes/${p.slug}`}><i class="modelo">{p.nome}</i></a></th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tabela.map((linha) => (
            <tr>
              <th scope="row">{linha.rotulo}</th>
              {linha.celulas.map((c) => <td>{c}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="caption plataformas__nota">{bikes.meta.nota_legal}</p>
  </div>
</section>

<!-- FECHAMENTO -->
<section class="secao fechamento">
  <span class="fechamento__brilho" aria-hidden="true"></span>

  <div class="container fechamento__interno">
    <h2 class="closer">Fuja do<br /><span class="verde">comum.</span></h2>

    <div class="fechamento__acao">
      <p class="lead">
        Conte para a gente como você pedala hoje. Em menos de 2 horas um especialista EDRO
        responde com o primeiro desenho da sua bike.
      </p>
      <a class="btn btn--primario btn--bloco"
         href={wa('Olá, EDRO. Quero ajuda para escolher a minha plataforma. (origem: site-bikes)')}
         rel="noopener" data-wa="fechamento-bikes">
        Falar com um especialista
        <svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

</Base>
