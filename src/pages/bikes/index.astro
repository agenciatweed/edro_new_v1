---
/* /bikes v3.3 (§7): a linha completa. Hero em carrossel de fotos escurecidas e todos os
   modelos em cards, fundo branco, agrupados por tipo (#road, #mountain-bike, #eletrica),
   as mesmas âncoras das abas da home. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CabecalhoLinha from '../../components/CabecalhoLinha.astro';
import Fechamento from '../../components/Fechamento.astro';
import fundos from '../../content/fundos.json';
import { TIPOS, linhaPorId, plataformas, wa, rodapeFicha } from '../../lib/edro.js';

const grupos = TIPOS.map((t) => ({ ...t, linhas: t.linhas.map(linhaPorId) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Bikes EDRO',
  itemListElement: plataformas.flatMap((p) => p.versoes.map((v) => ({ p, v }))).map(({ p, v }, i) => ({
    '@type': 'ListItem', position: i + 1, url: `https://edrobikes.com.br/bikes/${p.slug}/${v.slug}`, name: `EDRO ${p.nome} ${v.nome}`,
  })),
};
---

<Base
  titulo="Bikes EDRO · SUMMA, RANGE, IMPETUS e HORIZON de carbono sob medida"
  descricao="Todos os modelos EDRO: SUMMA hardtail XC, RANGE full suspension XC, IMPETUS road bike e as elétricas SUMMA HORIZON e RANGE HORIZON. Carbono monocoque, feitas à mão em Tubarão."
  canonica="https://edrobikes.com.br/bikes"
  pagina="bikes"
  jsonLd={jsonLd}
>

<Hero
  eyebrow="Bikes EDRO"
  linhas={['Diferentes propostas,', 'mas o mesmo <span class="verde">DNA</span> de performance.']}
  lead="Cada linha nasce de um molde exclusivo EDRO, construída em carbono monocoque, com modelagem EPS e prepreg de alto módulo. Cada bike é feita à mão, com pintura personalizada e exclusiva."
  fotos={fundos.bikes}
/>

<nav class="tipos-ancora" aria-label="Tipos de bicicleta">
  <div class="container tipos-ancora__interno">
    {grupos.map((g) => <a href={`#${g.id}`}>{g.rotulo}</a>)}
  </div>
</nav>

{grupos.map((g) => (
  <section class="secao secao--clara tipo-grupo" id={g.id} aria-labelledby={`tipo-${g.id}`}>
    <div class="container">
      <h2 class="tipo-grupo__titulo" id={`tipo-${g.id}`}>{g.rotulo}</h2>
      {g.linhas.map((l) => (
        <CabecalhoLinha linha={l} h="h3" conheca={g.id === 'eletrica' ? 'Conheça a HORIZON' : undefined} conhecaHref={g.id === 'eletrica' ? '/horizon' : undefined} />
      ))}
      <p class="nota-peso">{rodapeFicha.join(' ')}</p>
    </div>
  </section>
))}

<Fechamento linhas={['Fuja do']} verde="comum."
  texto="Fale diretamente com os especialistas que desenvolvem a sua bike."
  botoes={[
    { rotulo: 'Falar com um especialista', href: wa('Olá, EDRO. Quero ajuda para escolher a minha bike. (origem: site-bikes-fechamento)'), primario: true, wa: 'bikes-fechamento' },
    { rotulo: 'Conheça o FIT4U', href: '/fit4u' },
  ]} />

</Base>
