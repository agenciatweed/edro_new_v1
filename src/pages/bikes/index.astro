---
/* /bikes v3.1 · tela site_v3/02-bikes.png. As linhas não se comparam: sem tabela lado a lado. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CardLinha from '../../components/CardLinha.astro';
import Fechamento from '../../components/Fechamento.astro';
import { Image } from 'astro:assets';
import { bikes, plataformas, wa } from '../../lib/edro.js';
import { img } from '../../lib/imagens.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Linhas de bikes EDRO',
  itemListElement: plataformas.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://edrobikes.com.br/bikes/${p.slug}`, name: `EDRO ${p.nome}` })),
};
---

<Base
  titulo="Bikes EDRO · SUMMA, RANGE e IMPETUS de carbono sob medida"
  descricao="Três linhas de bikes de carbono feitas à mão em Tubarão: SUMMA hardtail XC, RANGE full suspension XC e IMPETUS road aero. Cada linha para um propósito. Qual é o seu?"
  canonica="https://edrobikes.com.br/bikes"
  pagina="bikes"
  jsonLd={jsonLd}
>

<Hero
  eyebrow="Bikes EDRO"
  linhas={['3 linhas de bikes.', 'Nenhuma <span class="verde">bike</span>']}
  verde="igual."
  lead="Cada linha foi projetada para um propósito específico. Qual é o seu? Todas nascem de um molde exclusivo EDRO em carbono monocoque, com modelagem EPS e prepreg de alto módulo, e chegam únicas."
  botoes={[
    { rotulo: 'Falar com um especialista', href: wa('Olá, EDRO. Quero ajuda para escolher a minha linha. (origem: site-bikes)'), primario: true, wa: 'bikes-hero' },
    { rotulo: 'Ver a HORIZON', href: '/horizon' },
  ]}
  fundo={{ src: 'lp/hero-edro-mtb.jpg', alt: 'Ciclista com EDRO em trilha de serra ao amanhecer', posicao: '70% center' }}
/>

<section class="secao secao--sem-linha">
  <div class="container">
    <h2 class="visualmente-oculto">As três linhas</h2>
    <div class="linhas__coluna">
      {plataformas.map((p) => <CardLinha p={p} larga />)}
    </div>
    <p class="nota-peso">{bikes.meta.nota_peso}</p>
  </div>
</section>

<section class="secao">
  <div class="container">
    <div class="card-horizon" style="margin-top:0">
      <div>
        <p class="eyebrow eyebrow--verde">Bikes elétricas</p>
        <Image src={img('brand/horizon.png')} alt="HORIZON" height={68} />
        <p>As mesmas linhas SUMMA e RANGE, com motor central e bateria integrada. Cara, peso e dinâmica de MTB, potência de e-bike full power.</p>
      </div>
      <a class="btn btn--secundario" href="/horizon">Conhecer a HORIZON</a>
    </div>
  </div>
</section>

<Fechamento linhas={['Fuja do']} verde="comum."
  texto="Não sabe por qual linha começar? Fale com um dos nossos especialistas."
  botoes={[
    { rotulo: 'Falar com um especialista', href: wa('Olá, EDRO. Não sei por qual linha começar. (origem: site-bikes-fechamento)'), primario: true, wa: 'bikes-fechamento' },
    { rotulo: 'Ver o FIT4U', href: '/fit4u' },
  ]} />

</Base>
