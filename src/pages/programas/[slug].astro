---
/* Páginas de programa v3.1 · telas site_v3/08 a 11. Selo oficial, como funciona em 4 passos,
   regras completas, o que não cobre e fechamento com o suporte. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Midia from '../../components/Midia.astro';
import ProvaSocial from '../../components/ProvaSocial.astro';
import Fechamento from '../../components/Fechamento.astro';
import conteudo from '../../content/programas.json';
import { wa, suporte } from '../../lib/edro.js';

export function getStaticPaths() {
  return conteudo.ordem.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pr = conteudo.programas[slug];
const linhasTitulo = pr.titulo;

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pr.nao_cobre.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

const DESCRICOES = {
  'compra-certa': 'Compra Certa EDRO: 10 dias a partir do recebimento para devolver a sua bike e receber 100% do valor, com coleta custeada pela EDRO.',
  'ciclo-edro': 'Ciclo EDRO: entre 18 e 24 meses, a sua EDRO pode compor a entrada da próxima, mediante avaliação técnica e comercial na fábrica.',
  'carbon-assist': 'Carbon Assist: assistência EDRO em caso de acidente não coberto pela garantia, com reparo do carbono na fábrica e garantia do quadro mantida.',
  garantia: 'Garantia vitalícia EDRO em quadro, garfo e componentes EDRO para o primeiro proprietário. Demais componentes com 2 anos e assistência no Brasil.',
};
---

<Base
  titulo={`${pr.nome} · Programas EDRO`}
  descricao={DESCRICOES[slug]}
  canonica={`https://edrobikes.com.br/programas/${slug}`}
  pagina={`programa-${slug}`}
  jsonLd={faq}
>

<Hero
  curto
  eyebrow="Programas EDRO"
  linhas={linhasTitulo}
  verde={' ' + pr.titulo_verde}
  lead={pr.lead}
  botoes={[{ rotulo: 'Falar com um especialista', href: wa(`Olá, EDRO. Tenho uma dúvida sobre o ${pr.nome}. (origem: site-${slug})`), primario: true, wa: `${slug}-hero` }]}
  selo={{ src: `brand/${pr.selo}`, alt: pr.selo_alt }}
  marcaDagua="EDRO"
/>

<section class="secao secao--sem-linha">
  <div class="container bloco2 bloco2--topo">
    <div>
      <h2 class="headline">Como <span class="verde">funciona.</span></h2>
      <ol class="passos3">
        {pr.passos.map(([t, d], i) => (<li><span class="passos3__num">{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></li>))}
      </ol>
    </div>
    <Midia titulo={pr.midia[0]} descricao={pr.midia[1]} proporcao="4x5" />
  </div>
</section>

<section class="secao">
  <div class="container bloco2 bloco2--topo">
    <div>
      <h2 class="headline">Regras <span class="verde">completas.</span></h2>
      <p class="lead">Transparência é um dos nossos valores. Tudo o que vale está aqui, sem letra miúda.</p>
    </div>
    <div class="lista-regras">
      {pr.regras.map(([t, d]) => (<details class="regra3" open><summary>{t}</summary><p>{d}</p></details>))}
    </div>
  </div>
</section>

<section class="secao">
  <div class="container bloco2 bloco2--topo">
    <h2 class="headline">O que não<br /><span class="verde">cobre.</span></h2>
    <dl class="qa">
      {pr.nao_cobre.map(([q, a]) => (<div><dt>{q}</dt><dd>{a}</dd></div>))}
    </dl>
  </div>
</section>

{slug === 'compra-certa' && (
  <section class="secao">
    <div class="container bloco2">
      <div>
        <h2 class="headline">Dez dias para<br />devolver. <span class="verde">Zero</span><br />devoluções.</h2>
        <p class="lead">Em todos esses anos, nenhuma EDRO voltou pela Compra Certa. O programa existe para tirar o risco da sua decisão; a bike existe para você não precisar usá-lo.</p>
      </div>
      <div><ProvaSocial apenas={['0']} /></div>
    </div>
  </section>
)}

<Fechamento linhas={pr.fechamento}
  texto="Dúvida sobre este programa? Fale direto com quem faz."
  botoes={[
    { rotulo: 'Falar com o suporte', href: wa(`Olá, suporte EDRO. Tenho uma dúvida sobre o ${pr.nome}. (origem: site-${slug}-suporte)`, suporte), primario: true, wa: `${slug}-suporte` },
    { rotulo: 'Ver os outros programas', href: '/programas' },
  ]} />

</Base>
