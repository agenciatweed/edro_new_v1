---
/* /comeca-aqui, landing do link da bio (16 e 17.5).
   Mobile-first, sem menu, sem rodapé completo, sem barra fixa.

   O capítulo 16 pede três botões: WhatsApp, Simulador de Ganhos e
   Guia FIT4U. O simulador ainda não existe no projeto, então o botão
   fica de fora até a página /simulador ser publicada: um botão para
   404 na página de maior tráfego do Instagram é pior que nenhum. */

import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { plataformas, kg, wa } from '../lib/edro.js';
import logoBranco from '../assets/logo/logo-branco.png';
---

<Base
  titulo="Sua EDRO sob medida começa aqui · EDRO Performance Bikes"
  descricao="Fale com um especialista EDRO pelo WhatsApp e conheça as três plataformas de carbono sob medida, feitas uma por vez em Tubarão, SC."
  canonica="https://edrobikes.com.br/comeca-aqui"
  pagina="comeca-aqui"
  enxuto={true}
>
  <div class="bio">
    <a class="bio__logo" href="/" aria-label="EDRO Performance Bikes, página inicial">
      <Image src={logoBranco} alt="EDRO Performance Bikes" height={28} densities={[1, 2]} loading="eager" />
    </a>

    <h1 class="display bio__titulo">Sua EDRO<br />sob medida<br />começa <span class="verde">aqui.</span></h1>

    <div class="bio__botoes">
      <a class="btn btn--primario btn--bloco" href={wa('Quero saber qual EDRO é a minha. (origem: instagram-bio)')} rel="noopener" data-wa="instagram-bio">
        Falar no WhatsApp
        <svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="btn btn--secundario btn--bloco" href="/fit4u#guia">Guia FIT4U</a>
    </div>

    <nav class="bio__plataformas" aria-label="Plataformas EDRO">
      {plataformas.map((p) => (
        <a class="bio__plataforma" href={`/bikes/${p.slug}`}>
          <span>
            <span class="bio__nome"><i class="modelo">{p.nome}</i></span>
            <span class="caption bio__uso">{p.uso_curto}</span>
          </span>
          <span class="bio__peso">{kg(p.pro.peso_kg)}<span class="unidade"> kg</span></span>
        </a>
      ))}
    </nav>

    <p class="caption bio__rodape">
      Feita uma por vez, em Tubarão, SC. #DeSCParaOMundo
      <br /><a href="/politicas">Políticas</a>
    </p>
  </div>
</Base>
