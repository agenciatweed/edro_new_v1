---
/* /contato v3.1 · tela site_v3/15-contato.png. Dois números oficiais, três finalidades, sem promessa de tempo. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Midia from '../components/Midia.astro';
import FormularioWhatsapp from '../components/FormularioWhatsapp.astro';
import { bikes, wa, comercial, suporte, telefoneBr } from '../lib/edro.js';

const ct = bikes.contato;
/* Link para o Google Maps em vez de mapa embutido: o iframe grava cookies antes do consentimento (LGPD). */
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Rua Rubens Faraco, 274, Tubarão, SC, 88708-270')}`;

const caminhos = [
  { t: 'Quero a minha EDRO.', d: 'Fale com um dos nossos especialistas, em horário comercial.', n: ct.whatsapp_comercial, href: wa('Olá, EDRO. Quero a minha EDRO. (origem: site-contato-comercial)', comercial), rot: 'Falar com um especialista', primario: true, w: 'contato-comercial' },
  { t: 'Já tenho uma EDRO.', d: 'Suporte, garantia, Carbon Assist e Ciclo EDRO.', n: ct.whatsapp_suporte, href: wa('Olá, suporte EDRO. Já tenho uma EDRO e preciso de ajuda com: ___ (origem: site-contato-suporte)', suporte), rot: 'Falar com o suporte', w: 'contato-suporte' },
  { t: 'Parcerias.', d: 'Atletas, embaixadores, treinadores parceiros e lojistas.', n: ct.whatsapp_comercial, href: wa('Olá, EDRO. Quero falar sobre parceria: ___ (origem: site-contato-parcerias)', comercial), rot: 'Falar sobre parceria', w: 'contato-parcerias' },
];

const campos = [
  { nome: 'nome', rotulo: 'Nome', tipo: 'text', obrigatorio: true, placeholder: 'Seu nome', autocomplete: 'name' },
  { nome: 'whatsapp', rotulo: 'WhatsApp', tipo: 'tel', obrigatorio: true, placeholder: '(48) 9 9999-9999', autocomplete: 'tel' },
  { nome: 'assunto', rotulo: 'Assunto', tipo: 'select', obrigatorio: true, opcoes: ['Quero a minha EDRO', 'Já tenho uma EDRO', 'Parcerias'] },
  { nome: 'mensagem', rotulo: 'Mensagem', tipo: 'textarea', obrigatorio: false, placeholder: 'Como você pedala hoje?' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'Organization', name: 'EDRO Performance Bikes', email: ct.email,
    contactPoint: [
      { '@type': 'ContactPoint', telephone: '+55-48-99110-2017', contactType: 'sales', areaServed: 'BR', availableLanguage: 'Portuguese' },
      { '@type': 'ContactPoint', telephone: '+55-48-99110-8117', contactType: 'customer support', areaServed: 'BR', availableLanguage: 'Portuguese' },
    ],
  },
};
const seta = '<svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---

<Base
  titulo="Contato · EDRO Performance Bikes, Tubarão SC"
  descricao="Fale com quem faz. WhatsApp comercial (48) 99110-2017, suporte (48) 99110-8117, e-mail e endereço da fábrica EDRO em Tubarão, SC."
  canonica="https://edrobikes.com.br/contato"
  pagina="contato"
  jsonLd={jsonLd}
>

<Hero curto eyebrow="Contato" linhas={['Fale com', 'quem']} verde=" faz." marcaDagua="EDRO"
  lead="Sem call center. Quem responde é a equipe da fábrica, em Tubarão." />

<section class="secao secao--sem-linha">
  <div class="container">
    <div class="caminhos3">
      {caminhos.map((c) => (
        <article class="caminho3">
          <h2 class="card-title">{c.t}</h2>
          <p>{c.d}</p>
          <p class="caminho3__numero">{telefoneBr(c.n)}</p>
          <a class:list={['btn', c.primario ? 'btn--primario' : 'btn--secundario']} href={c.href} rel="noopener" data-wa={c.w}>{c.rot}<Fragment set:html={c.primario ? seta : ''} /></a>
        </article>
      ))}
    </div>
    <div class="dados4">
      <div><b>E-mail</b><a href={`mailto:${ct.email}`}>{ct.email}</a></div>
      <div><b>Fábrica</b>{ct.endereco_curto}</div>
      <div><b>Horário</b>{ct.horario}</div>
      <div><b>Instagram</b><a href="https://www.instagram.com/edrobikes/" rel="noopener">{ct.instagram}</a></div>
    </div>
  </div>
</section>

<section class="secao">
  <div class="container bloco2 bloco2--topo">
    <div>
      <h2 class="headline">Prefere<br /><span class="verde">escrever?</span></h2>
      <p class="lead">Preencha e a mensagem abre pronta no WhatsApp, para você revisar e enviar.</p>
    </div>
    <div class="painel-form">
      <FormularioWhatsapp id="form-contato" campos={campos} numero={comercial}
        cabecalho="Olá, EDRO. Mensagem enviada pela página de contato." origem="site-contato-formulario" formulario="contato" rotulo="Enviar pelo WhatsApp" />
    </div>
  </div>
</section>

<section class="secao">
  <div class="container mapa-foto">
    <a class="mapa-link" href={mapa} target="_blank" rel="noopener">
      <p class="eyebrow eyebrow--verde">Mapa</p>
      <h3 class="card-title">Rua Rubens Faraco, 274</h3>
      <p>Tubarão, SC, CEP 88708-270. Abrir no Google Maps.</p>
    </a>
    <Midia titulo="Fachada da fábrica" descricao="Foto da fachada da fábrica EDRO em Tubarão, ao lado do mapa. 16:9." proporcao="16x9" />
  </div>
</section>

</Base>
