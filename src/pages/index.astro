---
/* Home v3.1 · tela site_v3/01-home.png e capítulo 4.01 da especificação. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Midia from '../components/Midia.astro';
import CardLinha from '../components/CardLinha.astro';
import Selos from '../components/Selos.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Fechamento from '../components/Fechamento.astro';
import { Image } from 'astro:assets';
import { bikes, plataformas, wa } from '../lib/edro.js';
import { img, videos } from '../lib/imagens.js';

const especialista = wa('Olá, EDRO. Quero falar com um dos especialistas sobre a minha EDRO. (origem: site-home)');

const slides = [
  {
    aba: 'HORIZON: além do horizonte',
    eyebrow: 'Bikes elétricas EDRO',
    linhas: ['Você, além do'], verde: 'horizonte.',
    lead: 'Cara, peso e dinâmica de MTB normal, com potência e autonomia de uma e-bike full power. Conheça a HORIZON.',
    botoes: [{ rotulo: 'Conhecer a HORIZON', href: '/horizon', primario: true }, { rotulo: 'Simular autonomia', href: '/horizon/simulador' }],
    brief: { tipo: 'VÍDEO', titulo: 'Banner 1 de 3: HORIZON em ação', descricao: 'Ciclista subindo uma serra em MTB elétrica, câmera acompanhando lateral, luz de fim de tarde. 12 a 20 s, sem som, loop.' },
  },
  {
    aba: 'FIT4U: feita para você',
    eyebrow: 'FIT4U',
    linhas: ['Feita para'], verde: 'você.',
    lead: 'Tamanho, cockpit e ajustes definidos pelas suas medidas, e uma pintura exclusiva desenhada com você. Nenhuma EDRO sai igual a outra.',
    botoes: [{ rotulo: 'Conhecer o FIT4U', href: '/fit4u', primario: true }, { rotulo: 'Iniciar o meu projeto', href: wa('Olá, EDRO. Quero iniciar o meu projeto FIT4U. (origem: site-home-banner)'), wa: 'home-banner-fit4u' }],
    fundo: { src: 'lp/customer-7.jpg', alt: 'Duas EDRO full suspension com pintura exclusiva FIT4U amarela', posicao: '60% center' },
  },
  {
    aba: 'RANGE: full de 9,89 kg',
    eyebrow: 'Full suspension XC, 100 mm',
    linhas: ['Full de'], verde: '9,89 kg.',
    lead: 'Tração de full com pedalada de hardtail: a suspensão trabalha no terreno e fica firme quando você acelera. Peso da RANGE PRO, sem pedais, no tamanho M.',
    botoes: [{ rotulo: 'Conhecer a RANGE', href: '/bikes/range', primario: true }, { rotulo: 'Ver as bikes', href: '/bikes' }],
    fundo: { src: 'lp/bike-range.jpg', alt: 'EDRO RANGE full suspension de carbono em estrada de terra ao entardecer', posicao: '70% center' },
  },
];

const tec = [
  { t: 'Monocoque', d: 'Quadro em peça única, sem juntas: menos peso, mais rigidez e nenhum ponto fraco onde um tubo encontra o outro.', destaque: true },
  { t: 'EPS', d: 'Núcleo expandido no lugar da bexiga: parede interna homogênea, sem excesso de resina. Mais leve e mais confiável.' },
  { t: 'Fibra 46T', d: 'Carbono de alto módulo, 40T e 46T por região: rigidez onde você pedala, conforto onde você senta.' },
  { t: 'Pintura', d: 'PU Acrílica Carbon Industrial, feita à mão: exclusiva, durável e tão leve que não pesa na balança.' },
];

const passos = [
  ['Você escolhe a bike', 'Linha e versão, com um especialista EDRO ao lado para orientar.'],
  ['Projeto de pintura exclusivo', 'Desenhado junto com você: cores do quadro, cores das logos, personalização e acabamento.'],
  ['Bike fit ou medidas', 'Você envia o relatório do seu bike fit ou as suas medidas, conforme o manual da EDRO.'],
  ['Pintura exclusiva à mão', 'Executada por artistas brasileiros, com cura em ambiente controlado.'],
  ['Montagem, inspeção e entrega', 'Montada à mão, inspecionada ponto a ponto e entregue em até 30 dias, com frete grátis.'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'EDRO Performance Bikes',
  url: 'https://edrobikes.com.br/',
  inLanguage: 'pt-BR',
};
---

<Base
  titulo="EDRO Performance Bikes · Bicicletas de carbono sob medida, feitas em Tubarão"
  descricao="Bicicletas de alta performance em carbono, feitas à mão em Tubarão, SC: SUMMA, RANGE, IMPETUS e a elétrica HORIZON, com FIT4U, pintura exclusiva e garantia vitalícia."
  canonica="https://edrobikes.com.br/"
  jsonLd={jsonLd}
>

<!-- 1 · BANNER EM CARROSSEL (troca manual: carrossel automático é proibido) -->
<div class="carrossel" data-carrossel>
  {slides.map((s, i) => (
    <div class="carrossel__slide" id={`slide-${i}`} role="tabpanel" aria-labelledby={`aba-${i}`} hidden={i !== 0}>
      <Hero eyebrow={s.eyebrow} linhas={s.linhas} verde={s.verde} lead={s.lead} botoes={s.botoes}
        fundo={s.fundo} brief={s.brief} titulo={i === 0 ? 'h1' : 'h2'} esconderBarra={i === 0} />
    </div>
  ))}
  <div class="carrossel__abas" role="tablist" aria-label="Destaques">
    {slides.map((s, i) => (
      <button class="carrossel__aba" type="button" role="tab" id={`aba-${i}`} aria-controls={`slide-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.aba}</button>
    ))}
  </div>
</div>

<!-- 2 · BARRA DE CONFIANÇA -->
<div class="confianca">
  <div class="container confianca__interno">
    <span class="confianca__item"><b>Garantia vitalícia</b> no quadro</span>
    <span class="confianca__item"><b>Frete grátis</b> para todo o Brasil</span>
    <span class="confianca__item"><b>12x</b> sem juros ou 5% no Pix</span>
    <span class="confianca__item"><b>30 dias</b> da medida à entrega</span>
    <span class="confianca__item confianca__item--verde"><b>Tubarão, SC</b> #DeSCParaOMundo</span>
  </div>
</div>

<!-- 3 · PARA QUEM É -->
<section class="secao secao--sem-linha">
  <div class="container filtro3">
    <div>
      <p class="eyebrow eyebrow--verde">Para quem é</p>
      <h2 class="headline">A EDRO não é<br />para <span class="verde">qualquer um.</span></h2>
      <p class="lead">Não fazemos bike de entrada, não fazemos volume e não vendemos por preço. Fazemos poucas por mês, para quem valoriza qualidade de ponta a ponta: do molde ao último parafuso, da laminação à entrega.</p>
      <div class="caixa caixa--sim">
        <span class="eyebrow eyebrow--verde">É para você se</span>
        <ul class="lista-sinal lista-sinal--mais">
          <li>Você já pedala, amador ou atleta, e a próxima bike precisa ser um salto, não uma troca.</li>
          <li>Você quer uma bike feita à mão, com a sua pintura, única no mundo.</li>
          <li>Você entende que peso, rigidez e componente certo são decisões de engenharia, não de catálogo.</li>
        </ul>
      </div>
      <div class="caixa">
        <span class="eyebrow">Provavelmente não é se</span>
        <ul class="lista-sinal lista-sinal--menos">
          <li>Esta vai ser a sua primeira bike.</li>
          <li>A decisão vai ser fechada na planilha, pelo menor preço.</li>
          <li>Para você, uma bike de prateleira resolve.</li>
        </ul>
        <p class="filtro__conciliador">Sem problema. Existem ótimas bikes para isso. A EDRO só não é uma delas.</p>
      </div>
    </div>
    <div class="filtro3__foto">
      <Midia src="lp/customer-1.jpg" proporcao="4x5" alt="Ciclista proprietária com a sua EDRO no início de uma trilha na serra"
        sizes="(max-width: 1023px) 100vw, 50vw" posicao="center 35%" />
    </div>
  </div>
</section>

<!-- 4 · TRÊS LINHAS -->
<section class="secao" id="linhas">
  <div class="container">
    <Cabecalho linhas={['3 linhas de bikes.', 'Nenhuma']} verde=" bike igual."
      lead="Cada linha nasce de um molde exclusivo EDRO em carbono monocoque, com modelagem EPS e prepreg de alto módulo. Cada bike é feita à mão, com a pintura que você escolheu, e chega única." />
    <div class="linhas__grade">
      {plataformas.map((p) => <CardLinha p={p} />)}
    </div>
    <div class="card-horizon">
      <div>
        <p class="eyebrow eyebrow--verde">Bikes elétricas</p>
        <Image src={img('brand/horizon.png')} alt="HORIZON" height={68} />
        <p>Cara, peso e dinâmica de MTB. Potência e autonomia de e-bike full power. Sobre as linhas SUMMA e RANGE.</p>
      </div>
      <a class="btn btn--secundario" href="/horizon">Conhecer a HORIZON</a>
    </div>
    <p class="nota-peso">{bikes.meta.nota_peso}</p>
  </div>
</section>

<!-- 5 · ENGENHARIA -->
<section class="secao">
  <div class="container bloco2">
    <div>
      <p class="eyebrow eyebrow--verde">Engenharia de carbono</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Leve porque foi<br /><span class="verde">decidido assim.</span></h2>
      <p class="lead">Um quadro EDRO não é leve por acaso. Cada lâmina de carbono tem orientação, módulo e posição definidos em projeto. O resultado você sente na primeira subida.</p>
      <a class="btn btn--secundario" href="/engenharia">Ver como uma EDRO nasce</a>
    </div>
    <div class="tec4">
      {tec.map((c) => (
        <div class:list={['tec', { 'tec--destaque': c.destaque }]}>
          <h3 class="card-title">{c.t}</h3>
          <p>{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="secao secao--sem-linha" style="padding-top:0">
  <div class="container galeria3">
    <Midia titulo="Macro da laminação" descricao="Mãos posicionando a lâmina de carbono no molde. Luz dura lateral, fundo escuro." />
    <Midia titulo="Cura e desmolde" descricao="Quadro saindo do molde, brilho da resina. Contraluz." />
    <Midia tipo="VÍDEO" titulo="Balança" descricao="Bike completa pendurada na balança, display legível: 8,47 kg, sem pedais. 8 s, loop." />
  </div>
</section>

<!-- 6 · O SOB MEDIDA -->
<section class="secao">
  <div class="container bloco2 bloco2--topo">
    <div>
      <p class="eyebrow eyebrow--verde">O sob medida</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Nenhuma EDRO<br />nasce <span class="verde">igual.</span></h2>
      <p class="lead" style="margin-bottom:var(--s-8)">Cada EDRO é feita à mão, ajustada às suas medidas e pintada com o projeto que você aprovou. Quando ela chega, não existe outra igual no mundo.</p>
      <Midia titulo="Detalhe da pintura à mão" descricao="Close no tubo com a pintura exclusiva sendo finalizada pelo artista, pincel e máscara. Formato 4:3." />
    </div>
    <ol class="passos3">
      {passos.map(([t, d], i) => (<li><span class="passos3__num">{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></li>))}
    </ol>
  </div>
</section>

<!-- 7 · PROGRAMAS -->
<section class="secao">
  <div class="container">
    <Cabecalho linhas={['O que só a', 'EDRO garante.']}
      lead="Quatro programas que existem para tirar o risco da decisão. Cada um responde a uma pergunta que você faria antes de investir em uma bike sob medida." />
    <Selos />
  </div>
</section>

<!-- 8 · MANIFESTO -->
<section class="manifesto">
  <div class="container manifesto__interno">
    <h2 class="manifesto-h2">Menos<br />marketing.<br /><span class="verde">Mais</span><br />performance.</h2>
    <div class="manifesto__texto">
      <p class="lead">A EDRO não compete por preço nem por volume. Não coloca um componente na bike sem ganho real de performance e sem assistência no Brasil.</p>
      <p class="manifesto__tese">Cada real que a gente não gasta te convencendo, a gente gasta na tua bike.</p>
      <p class="manifesto__desde">EDRO Performance Bikes <span class="verde">desde 2017</span></p>
    </div>
  </div>
</section>

<!-- 9 · FEITA PARA QUEM JÁ PEDALA -->
<section class="secao secao--sem-linha">
  <div class="container">
    <Cabecalho linhas={['Feita para quem']} verde="já pedala."
      lead="Milhares de ciclistas já escolheram a alta performance brasileira. Na lama, na pedra e no asfalto, com uma EDRO." />
    <div class="galeria3" style="margin-bottom:var(--s-5)">
      <Midia src="lp/customer-16.webp" alt="Ciclista EDRO em trilha fechada com lama, em prova" posicao="center 40%" />
      <Midia src="lp/customer-17.jpg" alt="Dois ciclistas EDRO em descida técnica de pedras" />
      <Midia src="lp/customer-18.jpg" alt="Ciclista com a EDRO IMPETUS azul e branca na estrada" posicao="center 60%" />
    </div>
    <ProvaSocial />
  </div>
</section>

<!-- 10 · POR QUE A EDRO -->
<section class="secao">
  <div class="container bloco2">
    <div>
      <h2 class="headline">Por que a EDRO é a<br />alta performance<br /><span class="verde">brasileira.</span></h2>
      <p class="lead">Em vez de explicar, a gente mostra. Vídeo real, sem roteiro de publicidade.</p>
    </div>
    <Midia video={videos.porque} proporcao="16x9" sizes="(max-width: 1023px) 100vw, 50vw" />
  </div>
</section>

<Fechamento linhas={['Fuja do']} verde="comum."
  texto="Fale com um dos nossos especialistas. Quem responde é quem projeta e monta a sua bike."
  botoes={[{ rotulo: 'Falar com um especialista', href: especialista, primario: true, wa: 'home-fechamento' }, { rotulo: 'Ver as bikes', href: '/bikes' }]} />

<script>
  const c = document.querySelector('[data-carrossel]');
  if (c) {
    const abas = [...c.querySelectorAll('[role="tab"]')];
    const slides = abas.map((a) => document.getElementById(a.getAttribute('aria-controls') || ''));
    const ir = (i, focar = false) => {
      abas.forEach((a, j) => { a.setAttribute('aria-selected', String(i === j)); a.tabIndex = i === j ? 0 : -1; if (slides[j]) slides[j].hidden = i !== j; });
      if (focar) abas[i].focus();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => ir(i));
      a.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); ir((i + d + abas.length) % abas.length, true); }
      });
    });
  }
</script>

</Base>
