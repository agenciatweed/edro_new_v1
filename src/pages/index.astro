---
/* Home v4: hero em carrossel (HORIZON, SUMMA, RANGE, IMPETUS e FIT4U, com a foto e o texto
   de cada página), seletor de modelos por tipo (fundo branco), E-Bikes (fundo branco),
   engenharia, sob medida, personalizador, programas, manifesto, prova social, fechamento
   e a barra de benefícios na base da página. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Midia from '../components/Midia.astro';
import Selos from '../components/Selos.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Fechamento from '../components/Fechamento.astro';
import BlocoPersonalizador from '../components/BlocoPersonalizador.astro';
import FundoRotativo from '../components/FundoRotativo.astro';
import AbasTipo from '../components/AbasTipo.astro';
import CardLinhaClara from '../components/CardLinhaClara.astro';
import { Image } from 'astro:assets';
import { img } from '../lib/imagens.js';
import programas from '../content/programas.json';
import fundos from '../content/fundos.json';
import { horizonLinhas, porSlug, wa, PERSONALIZADOR, personalizar } from '../lib/edro.js';

const summaPro = porSlug('summa').pro;
const especialista = wa('Olá, EDRO. Quero falar com um dos especialistas sobre a minha EDRO. (origem: site-home)');

/* Os cinco conteúdos do hero, na ordem do cliente (v4), cada um com a foto e o texto da sua página.
   O carrossel de fotos emite "fundo-troca" e o conteúdo da vez acompanha. */
const linhaHero = (slug) => {
  const p = porSlug(slug);
  return {
    eyebrow: p.tipo, logo: { linha: p }, h1Oculto: `EDRO ${p.nome}`, lead: p.hero_texto,
    botoes: [{ rotulo: `Conheça a ${p.nome}`, href: `/bikes/${slug}`, primario: true }, { rotulo: 'Personalize', href: personalizar(p.pro.chave) }],
    foto: fundos[slug][0],
  };
};
const slides = [
  {
    eyebrow: 'E-Bikes EDRO', logo: { soHorizon: true, alt: 'HORIZON' },
    linhas: ['Uma nova era em'], verde: 'E-Bikes.',
    lead: 'Redefinimos o ciclismo elétrico de alta performance. A linha Horizon materializa a união entre a agilidade de uma bike tradicional e a força de uma e-bike full power. Construída em carbono monocoque EDRO, essa plataforma ganha vida na eficiência da hardtail Summa e no controle total da full suspension Range. Escolha a sua versão e domine qualquer terreno.',
    botoes: [{ rotulo: 'Conheça a HORIZON', href: '/horizon', primario: true }, { rotulo: 'Simular autonomia', href: '/horizon/simulador' }],
    foto: fundos.horizon[0],
  },
  linhaHero('summa'),
  linhaHero('range'),
  linhaHero('impetus'),
  {
    eyebrow: 'FIT4U',
    linhas: ['A sua bike com'], verde: 'pintura personalizada.',
    lead: 'Na EDRO, você cria a pintura da sua bike ao seu gosto, sem qualquer custo adicional. Desenvolvemos o projeto visual com você e orientamos a escolha exata do tamanho do quadro e componentes, garantindo o ajuste ergonômico perfeito.',
    botoes: [{ rotulo: 'Simule a sua pintura', href: PERSONALIZADOR, primario: true }, { rotulo: 'Conheça o FIT4U', href: '/fit4u' }],
    foto: fundos.fit4u[0],
  },
];

/* Ícones de linha, desenhados no traço do sistema (§6.3). */
const ICONES = {
  escudo: '<path d="M12 3 4 6v6c0 4.6 3.4 8.1 8 9 4.6-.9 8-4.4 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  cartao: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3 10h18M7 15h4"/>',
  caminhao: '<path d="M3 6.5h11v9H3zM14 9.5h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
};
const beneficios = [
  ['escudo', 'Garantia vitalícia', 'para quadros, garfos e componentes EDRO'],
  ['cartao', `${summaPro.parcelamento.replace('em até ', '')}`, 'no cartão, ou 5% de desconto no Pix'],
  ['caminhao', 'Frete grátis', 'entrega em até 30 dias, para todo o Brasil'],
];

const tec = [
  { t: 'Monocoque', d: 'Quadro em peça única, sem juntas: menos peso, mais rigidez e nenhum ponto fraco onde um tubo encontra o outro.' },
  { t: 'EPS', d: 'Núcleo expandido no lugar da bexiga: parede interna homogênea, sem excesso de resina. Mais leve e mais confiável.' },
  { t: 'Fibra 46T', d: 'Carbono de alto módulo, 40T e 46T por região: rigidez onde você pedala, conforto onde você senta.' },
  { t: 'Pintura', d: 'PU Acrílica Carbon Industrial, feita à mão: exclusiva, durável e tão leve que não pesa na balança.' },
];

const passos = [
  ['Você escolhe a bike', 'Linha e versão, com um especialista EDRO ao lado para orientar.'],
  ['Projeto de pintura exclusivo', 'Montado no personalizador e aprovado com o design da EDRO: cores do quadro, cores das logos, personalização e acabamento.'],
  ['Bike fit ou medidas', 'Você envia o relatório do seu bike fit ou as suas medidas, conforme orientação da EDRO.'],
  ['Pintura exclusiva à mão', 'Executada por artistas brasileiros, com cura em ambiente controlado.'],
  ['Montagem, inspeção e entrega', 'Montada à mão, inspecionada ponto a ponto e entregue em até 30 dias, com frete grátis.'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'EDRO Performance Bikes',
  url: 'https://edrobikes.com.br/',
  inLanguage: 'pt-BR',
};
---

<Base
  titulo="EDRO Performance Bikes · Bicicletas de carbono sob medida, feitas em Tubarão"
  descricao="Bicicletas de alta performance em carbono, feitas à mão em Tubarão, SC: SUMMA, RANGE, IMPETUS e a elétrica HORIZON, com FIT4U, pintura exclusiva e garantia vitalícia."
  canonica="https://edrobikes.com.br/"
  jsonLd={jsonLd}
>

<!-- 1 · HERO EM CARROSSEL DE FOTOS -->
<div class="carrossel carrossel--fotos" data-carrossel aria-roledescription="carrossel" aria-label="Destaques">
  <FundoRotativo fotos={slides.map((s) => s.foto)} rotulo="Fotos e destaques" />
  {slides.map((s, i) => (
    <div class="carrossel__slide" id={`slide-${i}`} hidden={i !== 0} aria-roledescription="slide" aria-label={`${i + 1} de ${slides.length}`}>
      <Hero eyebrow={s.eyebrow} logo={s.logo} h1Oculto={s.h1Oculto} linhas={s.linhas} verde={s.verde} lead={s.lead} botoes={s.botoes}
        sobreFotos titulo={i === 0 ? 'h1' : 'h2'} esconderBarra={i === 0} />
    </div>
  ))}
</div>

<!-- 2 · SELETOR DE MODELOS POR TIPO (branco) -->
<section class="secao secao--clara" id="modelos">
  <div class="container">
    <div class="home-modelos__topo">
      <h2 class="headline">Diferentes propostas, mas o mesmo <span class="verde">DNA</span> de performance.</h2>
      <p class="lead">Cada linha nasce de um molde exclusivo EDRO, construída em carbono monocoque, com modelagem EPS e prepreg de alto módulo. Cada bike é feita à mão, com pintura personalizada e exclusiva.</p>
    </div>
    <AbasTipo />
  </div>
</section>

<!-- 4 · E-BIKES (branco) -->
<section class="secao secao--clara" id="e-bikes">
  <div class="container">
    <div class="home-modelos__topo">
      <h2 class="headline">Um novo conceito em <span class="verde">E-Bikes.</span></h2>
      <p class="lead">A linha Horizon une a leveza, o peso e a dinâmica de uma bike normal à potência e autonomia de uma e-bike full power. Desenvolvida em carbono monocoque EDRO, ela entrega agilidade máxima e pilotagem precisa sempre que você quiser, com força e torque de sobra para quando você precisar.</p>
    </div>
    <div class="linhas-claras">
      {horizonLinhas.map((l) => <CardLinhaClara linha={l} versao={l.slug === 'summa-horizon' ? 'ex' : 'pro'} />)}
    </div>
  </div>
</section>

<!-- 5 · ENGENHARIA -->
<section class="secao secao--sem-linha home-eng">
  <div class="container bloco2">
    <div>
      <p class="eyebrow eyebrow--verde">Engenharia de carbono</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Leve porque foi<br /><span class="verde">desenvolvido</span><br />para ser.</h2>
      <p class="lead">Um quadro EDRO não é leve por acaso. Cada lâmina de carbono tem orientação, módulo e posição definidos em projeto. O resultado você sente na primeira subida.</p>
      <a class="btn btn--secundario" href="/engenharia">Veja como nasce uma EDRO</a>
    </div>
    <div class="tec4">
      {tec.map((c) => (
        <div class="tec">
          <h3 class="card-title">{c.t}</h3>
          <p>{c.d}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="container galeria3 home-eng__galeria">
    <Midia src="aj3/laminacao-01.jpg" alt="Quadro de carbono EDRO recém-laminado, ainda sem pintura, na mão de quem fabrica" proporcao="3x4" />
    <Midia clipe={{ src: '/videos/cura-desmolde.mp4', poster: '/videos/cura-desmolde.jpg', rotulo: 'Cura e desmolde de um quadro EDRO na fábrica' }} proporcao="3x4" />
    <Midia clipe={{ src: '/videos/balanca.mp4', poster: '/videos/balanca.jpg', rotulo: 'Quadro EDRO pesado na balança da fábrica' }} proporcao="3x4" />
  </div>
</section>

<!-- 6 · O SOB MEDIDA -->
<section class="secao">
  <div class="container">
    <Cabecalho eyebrow="O sob medida" linhas={['Nenhuma EDRO', 'nasce']} verde=" igual."
      lead="Cada EDRO é construída à mão, ajustada às suas medidas e finalizada com a pintura que você escolheu. O resultado é uma bicicleta genuinamente única." />
    <div class="bloco2 sob-medida">
      <Midia src="fotos/pintura-cabine.jpg" alt="Artista EDRO pintando à mão um quadro na cabine de pintura" posicao="center 35%" />
      <ol class="passos3">
        {passos.map(([t, d], i) => (<li><span class="passos3__num">{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></li>))}
      </ol>
    </div>
  </div>
</section>

<!-- 7 · PERSONALIZADOR FIT4U -->
<BlocoPersonalizador variante="home" />

<!-- 8 · PROGRAMAS -->
<section class="secao">
  <div class="container">
    <div class="programas-home__topo">
      <h2 class="headline">O que só a<br />EDRO <span class="verde">garante.</span></h2>
      <div>
        <div class="programas-home__selos">
          {programas.ordem.map((slug) => (
            <a href={`/programas#${slug}`}><Image src={img(`brand/${programas.programas[slug].selo}`)} alt={programas.programas[slug].selo_alt} height={180} /></a>
          ))}
        </div>
        <p class="lead">Quatro programas que existem para tirar o risco da decisão de investir em uma bike sob medida.</p>
      </div>
    </div>
    <Selos semSelo />
  </div>
</section>

<!-- 9 · MANIFESTO -->
<section class="manifesto">
  <div class="container manifesto__interno">
    <h2 class="manifesto-h2">Menos<br />marketing.<br /><span class="verde">Mais</span><br />performance.</h2>
    <div class="manifesto__texto">
      <p class="lead">Escolhemos o rigor técnico e a exclusividade. Cada componente cumpre uma função clara de desempenho, com suporte dedicado e assistência técnica completa no Brasil.</p>
      <p class="lead">Direcionamos todos os nossos recursos para a engenharia e para o que realmente importa: a sua experiência ao pedalar.</p>
      <p class="manifesto__tese">Cada real que não gastamos te convencendo, a gente investe na sua bike.</p>
      <p class="manifesto__desde">EDRO Performance Bikes <span class="verde">desde 2017</span></p>
    </div>
  </div>
</section>

<!-- 10 · PROVA SOCIAL -->
<section class="secao secao--sem-linha">
  <div class="container">
    <Cabecalho linhas={['Construída para']} verde="quem pedala."
      lead="Uma comunidade de ciclistas que escolheu o rigor da alta performance nacional. Da terra ao asfalto, a EDRO acompanha ciclistas que exigem o máximo em qualquer terreno." />
    <div class="galeria3" style="margin-bottom:var(--s-5)">
      <Midia src="aj3/quem-pedala-01.jpg" alt="Ciclista EDRO pedalando a sua mountain bike em estrada de terra na serra" posicao="center 45%" />
      <Midia src="aj3/quem-pedala-02.jpg" alt="Ciclista EDRO com número de prova em trilha de mountain bike" posicao="center 40%" />
      <Midia src="aj3/quem-pedala-03.jpg" alt="Ciclista EDRO em descida técnica de prova de mountain bike" posicao="center 50%" />
    </div>
    <ProvaSocial />
  </div>
</section>

<Fechamento linhas={['Fuja do']} verde="comum."
  texto="Fale diretamente com os especialistas que desenvolvem a sua bike."
  botoes={[{ rotulo: 'Falar com um especialista', href: especialista, primario: true, wa: 'home-fechamento' }, { rotulo: 'Ver as bikes', href: '/bikes' }]} />

<!-- BARRA DE BENEFÍCIOS (v4: na base da página) -->
<div class="beneficios">
  <div class="container beneficios__interno">
    {beneficios.map(([icone, t, d]) => (
      <div class="beneficio">
        <svg class="beneficio__icone" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONES[icone]} />
        <p><b>{t}</b><span>{d}</span></p>
      </div>
    ))}
  </div>
</div>

<script>
  /* Os conteúdos do hero acompanham a foto da vez (o carrossel de fotos emite "fundo-troca"). */
  const c = document.querySelector<HTMLElement>('[data-carrossel]');
  if (c) {
    const slides = [...c.querySelectorAll<HTMLElement>('.carrossel__slide')];
    c.addEventListener('fundo-troca', (e) => {
      const i = (e as CustomEvent<number>).detail % slides.length;
      slides.forEach((s, j) => { s.hidden = i !== j; });
    });
  }
</script>

</Base>
