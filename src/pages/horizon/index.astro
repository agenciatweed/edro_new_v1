---
/* /horizon v3.2 · tela site_v3_2/16-horizon.png e seção 3.1 da atualização.
   1.200 W sempre com a potência nominal de 600 W; 45 km/h sempre com circuito fechado e legislação;
   sem acelerador e arrasto zero só nos detalhes técnicos; sem menção às células da bateria.
   Preços, pesos, "para quem", sistema elétrico e "O que muda no seu pedal" vêm do catálogo 2027. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import Midia from '../../components/Midia.astro';
import AutonomiaReal from '../../components/AutonomiaReal.astro';
import Fechamento from '../../components/Fechamento.astro';
import { Image, Picture } from 'astro:assets';
import dev from '../../content/horizon_desenvolvimento.json';
import { brl, wa, junto, horizonLinhas, catalogoHz, pesoTexto, rodapeFicha } from '../../lib/edro.js';
import { img } from '../../lib/imagens.js';

const falar = wa('Olá, EDRO. Quero montar a minha HORIZON. (origem: site-horizon)');
const summaH = horizonLinhas.find((l) => l.slug === 'summa-horizon');
const rangeH = horizonLinhas.find((l) => l.slug === 'range-horizon');
const modelo = (s) => s.replace(/\b(SUMMA|RANGE)\b/g, '<i class="modelo">$1</i>');
const pesos = (s) => s.replace('{peso_summa}', summaH.pro.peso_texto).replace('{peso_range}', rangeH.pro.peso_texto);
const rotulos = ['O desafio', 'O que a EDRO fez', 'O que você sente'];
---

<Base
  titulo="HORIZON · Mountain bike elétrica EDRO de carbono, SUMMA e RANGE"
  descricao={`HORIZON: a versão eletrificada, de pedal assistido, da SUMMA e da RANGE. 1.200 W de pico, potência nominal de 600 W, 135 N.m, EDRO Power Pack de 540 Wh, a partir de ${summaH.pro.peso_texto} sem pedais.`}
  canonica="https://edrobikes.com.br/horizon"
  pagina="horizon"
>

<Hero
  eyebrow="Bikes elétricas EDRO"
  wordmark="brand/horizon.png"
  wordmarkAlt="HORIZON"
  wordmarkClasse="hero3__wordmark--horizon"
  linhas={['Você, além do']}
  verde="horizonte."
  lead="Cara de bike normal. Peso de bike normal. Dinâmica de bike normal. E potência e autonomia de uma e-bike full power. Leveza e dinâmica sempre que quiser, potência de sobra quando precisar."
  botoes={[{ rotulo: 'Montar a minha HORIZON', href: falar, primario: true, wa: 'horizon-hero' }, { rotulo: 'Simular autonomia', href: '/horizon/simulador' }]}
  peso={{ valor: pesoTexto(summaH.pro), rotulo: '<i class="modelo">SUMMA</i> PRO HORIZON, sem pedais, tamanho M' }}
  clipe={{ src: '/videos/horizon-banner.mp4', poster: '/videos/horizon-banner.jpg', rotulo: 'SUMMA HORIZON pedalando em estrada à beira-mar' }}
/>

<div class="container">
  <div class="faixa-specs">
    <div><b>1.200 W</b> de pico; potência nominal limitada a 600 W</div>
    <div><b>135 N.m</b> de torque, para subir no seu ritmo</div>
    <div><b>540 Wh</b> EDRO Power Pack; até 185 km no modo Eco</div>
    <div><b>{summaH.pro.peso_texto}</b> <i class="modelo">SUMMA</i> PRO HORIZON, peso total sem pedais, tamanho M</div>
    <div><b>32 km/h</b> de fábrica; ajustável a 45 km/h em circuito fechado, conforme a legislação</div>
  </div>
</div>

<!-- Mais pedal, com sensação de bike normal (texto do catálogo) -->
<section class="secao secao--sem-linha">
  <div class="container bloco2">
    <div>
      <p class="eyebrow eyebrow--verde">HORIZON</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Mais pedal, com<br /><span class="verde">sensação de bike normal.</span></h2>
    </div>
    <div>
      <p class="lead">A HORIZON é a versão eletrificada, de pedal assistido, das bikes de cross country da EDRO. Ela foi desenvolvida pela EDRO com a mesma concepção da <i class="modelo">SUMMA</i> e da <i class="modelo">RANGE</i>: a mesma geometria, a dinâmica de uma bike normal e peso de bike de XC. É para quem já pedala e quer voltar ao ritmo, acompanhar um grupo mais forte, ir mais longe e subir mais.</p>
      <p class="assinatura-verde">O seu melhor ritmo. Todos os dias.</p>
    </div>
  </div>
</section>

<!-- Desenvolvida, não adaptada (v3.2, seção 3.2) -->
<section class="secao" id="desenvolvimento">
  <div class="container">
    <div class="dev__topo">
      <div>
        <p class="eyebrow eyebrow--verde">Desenvolvimento</p>
        <h2 class="headline" style="margin:var(--s-4) 0 var(--s-6)">Desenvolvida,<br />não <span class="verde">adaptada.</span></h2>
        <p class="lead" set:html={dev.abertura} />
      </div>
      <figure class="dev__foto">
        <div class="dev__palco">
          <Picture src={img(summaH.pro.foto)} formats={['avif', 'webp']} alt="EDRO SUMMA PRO HORIZON 2027, vista lateral, com o motor, o quadro e o EDRO Power Pack marcados"
            widths={[800, 1600]} sizes="(max-width: 1023px) 100vw, 50vw" loading="lazy" />
          {dev.marcadores.map((m) => (
            <span class="dev__marcador" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">{m.n}</span>
          ))}
        </div>
        <figcaption class="caption" set:html={dev.marcadores.map((m) => `${m.n} ${modelo(m.rotulo)}`).join(' · ')} />
      </figure>
    </div>

    <div class="dev__cards">
      {dev.cards.map((c, i) => (
        <article class:list={['dev__card', { 'dev__card--destaque': c.destaque }]}>
          <h3 class="dev__titulo"><span class="verde">{i + 1}</span> {c.titulo}</h3>
          <dl>
            {[c.desafio, pesos(c.fez), c.sente].map((t, j) => (
              <div><dt>{rotulos[j]}</dt><dd set:html={junto(t)} /></div>
            ))}
          </dl>
        </article>
      ))}
    </div>
    <p class="dev__fecho">{dev.fecho[0]} <span class="verde">{dev.fecho[1]}</span></p>
  </div>
</section>

<!-- O que muda no seu pedal + Sistema elétrico, igual nas seis versões -->
<section class="secao">
  <div class="container">
    <div class="bloco2 bloco2--topo">
      <div>
        <p class="eyebrow eyebrow--verde">No seu pedal</p>
        <h2 class="headline" style="margin:var(--s-4) 0 var(--s-6)">O que muda<br />no seu <span class="verde">pedal.</span></h2>
        <ul class="pedal-lista">
          {catalogoHz.no_seu_pedal.map((f) => <li><b>{f.titulo}</b> {f.texto}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow eyebrow--verde">Sistema elétrico</p>
        <h2 class="headline headline--media" style="margin:var(--s-4) 0 var(--s-6)">Igual nas<br /><span class="verde">seis versões.</span></h2>
        <dl class="detalhes-tec" style="margin-top:0">
          {Object.entries(catalogoHz.sistema).map(([k, v]) => (<div><dt>{k}</dt><dd>{junto(v)}</dd></div>))}
        </dl>
      </div>
    </div>
    <div class="galeria3" style="margin-top:var(--s-12)">
      <Midia src="fotos/horizon-display.jpg" alt="Display da HORIZON no guidão, com a mão do ciclista" legenda="<strong>Display e app</strong>Display 2,1&quot; IP65 e app Ride Control." />
      <Midia titulo="Motor e Power Pack" descricao="Macro do motor CYC Photon Gen 2 e do EDRO Power Pack no quadro, luz lateral." />
      <Midia titulo="Recarga na bike" descricao="EDRO Power Pack sendo recarregado na própria bike, na garagem." />
    </div>
  </div>
</section>

<AutonomiaReal />

<!-- Duas linhas. Seis HORIZON. -->
<section class="secao">
  <div class="container">
    <Cabecalho eyebrow="Linhas" linhas={['Duas linhas.', 'Seis']} verde=" HORIZON."
      lead="Escolha a linha pelo terreno e a versão pelos componentes. Motor e EDRO Power Pack são os mesmos nas seis. Quadro, pintura e ajustes são feitos para você." />
    <div class="linhas__grade" style="grid-template-columns:1fr 1fr">
      {horizonLinhas.map((l) => (
        <article class="card-linha card-horizon-linha">
          <p class="eyebrow">{l.tipo}</p>
          <h3 class="card-linha__wordmark">
            <a class="card-linha__link" href={`/horizon/${l.slug}`}>
              <span class="visualmente-oculto">{l.nome} HORIZON</span>
              <Image src={img(`brand/${l.base}.png`)} alt="" height={60} />
              <Image src={img('brand/horizon.png')} alt="" height={40} />
            </a>
          </h3>
          <span class="card-linha__canto" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg></span>
          <span class="card-linha__render">
            <Picture src={img(l.pro.foto)} formats={['avif', 'webp']} alt={`EDRO ${l.nome} PRO HORIZON 2027, vista lateral`} widths={[800, 1600]} sizes="(max-width: 767px) 100vw, 50vw" loading="lazy" />
          </span>
          <p class="card-linha__beneficio" set:html={`${modelo(l.para_quem)}.`} />
          <dl class="versoes-lista">
            {l.versoes.map((v) => (<div><dt><span class="verde">{v.nome}</span> · {v.peso_texto}</dt><dd><b>{brl(v.preco)}</b> {v.parcelamento}</dd></div>))}
          </dl>
          <div class="card-linha__acoes">
            <span class="btn btn--primario btn--pequeno">Conhecer a {l.nome} HORIZON</span>
            <a class="card-linha__extra link-seta" href={l.pro.personalizar} data-personalizar={`horizon-${l.slug}`}>Personalize a pintura</a>
          </div>
        </article>
      ))}
    </div>
    <p class="nota-peso">{rodapeFicha.join(' ')}</p>
  </div>
</section>

<section class="secao">
  <div class="container">
    <p class="eyebrow eyebrow--verde">Para quem é</p>
    <h2 class="headline" style="margin:var(--s-4) 0 var(--s-6)">Uma eMTB para quem<br /><span class="verde">já pedala.</span></h2>
    <p class="lead">A HORIZON é para quem quer uma eMTB para subir mais alto e ir mais longe, sem a sensação de estar montado em um elefante. As bikes normais são como cavalos: leves, ágeis, respondem ao corpo. A HORIZON é um cavalo com potência de sobra.</p>
    <div class="filtro__caixas--duas">
      <div class="caixa caixa--sim">
        <span class="eyebrow eyebrow--verde">É para você se</span>
        <ul class="lista-sinal lista-sinal--mais">
          <li>Você quer subir mais alto e ir mais longe, sentindo que está em uma MTB normal, com o motor entrando só quando você pede.</li>
          <li>Você está fora de forma, ou ficou um tempo parado, e o grupo ficou mais forte que você.</li>
          <li>Você quer uma bike com comportamento, cara e peso de bike normal, mas com assistência full power quando precisar.</li>
          <li>Você quer uma bike sob medida e personalizada, como toda EDRO.</li>
        </ul>
      </div>
      <div class="caixa">
        <span class="eyebrow">Provavelmente não é se</span>
        <ul class="lista-sinal lista-sinal--menos">
          <li>Você procura uma e-bike de enduro ou downhill, com curso longo e peso de moto.</li>
          <li>Você quer uma e-bike de passeio ou para o dia a dia na cidade.</li>
          <li>Você aceita uma e-bike que pareça uma moto, que precise de ajuda para carregar ou que não tenha a leveza de uma bike normal na pilotagem.</li>
        </ul>
        <p class="filtro__conciliador">Existem ótimas e-bikes para isso. A HORIZON foi feita para outra coisa.</p>
      </div>
    </div>
  </div>
</section>

<Fechamento linhas={['Monte a sua']} verde="HORIZON."
  texto="Conte como você pedala hoje e onde quer chegar. Um dos nossos especialistas responde com a simulação de autonomia do seu treino."
  botoes={[{ rotulo: 'Falar sobre a minha HORIZON', href: wa('Olá, EDRO. Quero falar sobre a minha HORIZON. (origem: site-horizon-fechamento)'), primario: true, wa: 'horizon-fechamento' }, { rotulo: 'Enviar meu pedal para simulação', href: '/horizon/simulador' }]} />

</Base>
