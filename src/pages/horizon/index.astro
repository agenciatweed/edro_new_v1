---
/* /horizon v3.3 (§10): hero de foto escurecida com a logo HORIZON, modelos em cards
   brancos, mais pedal, desenvolvimento, quatro blocos, no seu pedal + sistema elétrico,
   simulador, perfil HORIZON e fechamento.
   1.200 W sempre com a potência nominal de 600 W; 45 km/h sempre com circuito fechado e
   legislação; sem menção às células da bateria. Pesos e sistema elétrico do catálogo 2027. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Midia from '../../components/Midia.astro';
import AutonomiaReal from '../../components/AutonomiaReal.astro';
import CabecalhoLinha from '../../components/CabecalhoLinha.astro';
import Fechamento from '../../components/Fechamento.astro';
import { Picture } from 'astro:assets';
import dev from '../../content/horizon_desenvolvimento.json';
import fundos from '../../content/fundos.json';
import { junto, horizonLinhas, catalogoHz, rodapeFicha } from '../../lib/edro.js';
import { img } from '../../lib/imagens.js';

const summaH = horizonLinhas.find((l) => l.slug === 'summa-horizon');
const rangeH = horizonLinhas.find((l) => l.slug === 'range-horizon');
const modelo = (s) => s.replace(/\b(SUMMA|RANGE)\b/g, '<i class="modelo">$1</i>');
const pesos = (s) => s.replace('{peso_summa}', summaH.pro.peso_texto).replace('{peso_range}', rangeH.pro.peso_texto);
---

<Base
  titulo="HORIZON · E-Bikes EDRO de carbono, SUMMA HORIZON e RANGE HORIZON"
  descricao={`HORIZON: a versão eletrificada, de pedal assistido, da SUMMA e da RANGE. 1.200 W de pico, potência nominal de 600 W, 135 N.m, EDRO Power Pack de 540 Wh, a partir de ${summaH.pro.peso_texto} sem pedais.`}
  canonica="https://edrobikes.com.br/horizon"
  pagina="horizon"
>

<Hero
  eyebrow="E-Bikes EDRO"
  wordmark="brand/horizon.png"
  wordmarkAlt="HORIZON"
  wordmarkClasse="hero3__wordmark--horizon"
  linhas={['Uma nova era em']}
  verde="E-Bikes."
  lead="Redefinimos o ciclismo elétrico de alta performance. A linha Horizon materializa a união entre a agilidade de uma bike tradicional e a força de uma e-bike full power. Construída em carbono monocoque EDRO, essa plataforma ganha vida na eficiência da hardtail Summa e no controle total da full suspension Range. Escolha a sua versão e domine qualquer terreno."
  fotos={fundos.horizon}
/>

<!-- Modelos HORIZON (branco) -->
<section class="secao secao--clara" id="modelos">
  <div class="container">
    {horizonLinhas.map((l) => <CabecalhoLinha linha={l} h="h2" />)}
    <p class="nota-peso">{rodapeFicha.join(' ')}</p>
  </div>
</section>

<!-- Mais pedal -->
<section class="secao secao--sem-linha">
  <div class="container bloco2">
    <div>
      <p class="eyebrow eyebrow--verde">HORIZON</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Mais pedal, com sensação de bike <span class="verde">convencional.</span></h2>
    </div>
    <div>
      <p class="lead">A HORIZON é a versão eletrificada, de pedal assistido, das bikes de cross country da EDRO. Elas foram desenvolvidas com a mesma concepção da <i class="modelo">SUMMA</i> e da <i class="modelo">RANGE</i>: as mesmas geometrias já consagradas com a dinâmica de uma bike convencional e peso de bike de XC. É para quem já pedala e quer voltar ao ritmo, acompanhar um grupo mais forte, ir mais longe e subir mais.</p>
    </div>
  </div>
</section>

<!-- Desenvolvimento: a bike com os marcadores sobre branco -->
<section class="secao" id="desenvolvimento">
  <div class="container">
    <div class="dev__topo">
      <div>
        <p class="eyebrow eyebrow--verde">Desenvolvimento</p>
        <h2 class="headline" style="margin:var(--s-4) 0 var(--s-6)">Estrutura de XC e dinâmica <span class="verde">preservada.</span></h2>
        <p class="lead" set:html={dev.abertura} />
      </div>
      <figure class="dev__foto dev__foto--clara">
        <div class="dev__palco">
          <Picture src={img(summaH.pro.foto)} formats={['avif', 'webp']} alt="EDRO SUMMA PRO HORIZON 2027, vista lateral, com o motor, o quadro e o EDRO Power Pack marcados"
            widths={[800, 1600]} sizes="(max-width: 1023px) 100vw, 50vw" loading="lazy" />
          {dev.marcadores.map((m) => (
            <span class="dev__marcador" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">{m.n}</span>
          ))}
        </div>
        <figcaption class="caption" set:html={dev.marcadores.map((m) => `${m.n} ${modelo(m.rotulo)}`).join(' · ')} />
      </figure>
    </div>

    <div class="dev__cards">
      {dev.cards.map((c, i) => (
        <article class:list={['dev__card', { 'dev__card--destaque': c.destaque }]}>
          <h3 class="dev__titulo"><span class="verde">{i + 1}</span> {c.titulo}</h3>
          <dl>
            {[c.desafio, pesos(c.fez), c.sente].map((t, j) => (
              <div><dt>{dev.rotulos[j]}</dt><dd set:html={junto(t)} /></div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- No seu pedal + Sistema elétrico -->
<section class="secao">
  <div class="container">
    <div class="bloco2 bloco2--topo">
      <div>
        <p class="eyebrow eyebrow--verde">No seu pedal</p>
        <h2 class="headline" style="margin:var(--s-4) 0 var(--s-6)">O que muda<br />no seu <span class="verde">pedal.</span></h2>
        <ul class="pedal-lista">
          {dev.no_seu_pedal.map((f) => <li><b>{f.titulo}</b> {f.texto}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow eyebrow--verde">Sistema elétrico</p>
        <h2 class="headline headline--media" style="margin:var(--s-4) 0 var(--s-6)">Mesma engenharia em toda <span class="verde">linha.</span></h2>
        <dl class="detalhes-tec" style="margin-top:0">
          {Object.entries(catalogoHz.sistema).map(([k, v]) => (<div><dt>{k}</dt><dd>{junto(v)}</dd></div>))}
        </dl>
      </div>
    </div>
    <div class="galeria3" style="margin-top:var(--s-12)">
      <Midia src="fotos/horizon-display.jpg" alt="Display da HORIZON no guidão, com a mão do ciclista" legenda="<strong>Display e app</strong>Display 2,1&quot; IP65 e app Ride Control." />
      <Midia titulo="Motor e Power Pack" descricao="Macro do motor CYC Photon Gen 2 e do EDRO Power Pack no quadro, luz lateral." />
      <Midia titulo="Recarga na bike" descricao="EDRO Power Pack sendo recarregado na própria bike, na garagem." />
    </div>
  </div>
</section>

<AutonomiaReal />

<!-- Perfil HORIZON: um box só -->
<section class="secao">
  <div class="container">
    <div class="perfil-box">
      <div class="perfil-box__topo">
        <div>
          <p class="eyebrow eyebrow--verde">Perfil HORIZON</p>
          <h2 class="headline" style="margin-top:var(--s-4)">Projetada para a sua <span class="verde">pilotagem.</span></h2>
        </div>
        <p class="lead">{dev.perfil.texto}</p>
      </div>
      <dl class="perfil-box__itens">
        {dev.perfil.itens.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
      </dl>
    </div>
  </div>
</section>

<Fechamento linhas={['Monte a sua']} verde="HORIZON."
  texto="Escolha o modelo, a configuração e os componentes ideais para o seu estilo de pilotagem."
  botoes={[{ rotulo: 'Escolher minha HORIZON', href: '#modelos', primario: true }]} />

</Base>
