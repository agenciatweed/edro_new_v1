---
/* =============================================================
   Cabeçalho do site (v3.3): branco em todas as páginas, só a
   tipografia EDRO no logo (a home é pelo logo), quatro itens com
   painel suspenso e "Quero ser lojista" em destaque à direita.

   Bikes e E-Bikes: cada linha com a foto da PRO, o tipo, o nome e
   as versões em chips (EX | XCR | PRO). Monte a sua e Diferenciais:
   colunas de links.

   Usado no site (fixo no topo) e no personalizador FIT4U (rola com a
   página). Por isso as classes têm prefixo "sm-" e os estilos são
   inline e explícitos: nada do CSS do personalizador muda o menu.

   Desktop: abre por hover, clique ou teclado (aria-expanded, Esc fecha).
   Celular: tela cheia branca com acordeão; lojista fixo no rodapé.
   ============================================================= */
import { getImage } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { menu, LOJISTA, LOGO_MENU } from '../lib/menu.js';
import { linhaPorId, urlLinha, urlModelo, nomeLinha } from '../lib/edro.js';

const { fixo = true, atual = '' } = Astro.props;
const logo = await getImage({ src: img(LOGO_MENU), height: 60 });
const larguraLogo = Math.round((logo.attributes.width / logo.attributes.height) * 28);

const itens = await Promise.all(menu.map(async (m) => ({
  ...m,
  ativo: atual === m.href || atual.startsWith(m.href + '/') || (m.id === 'monte' && atual.startsWith('/fit4u')),
  linhas: m.linhas && await Promise.all(m.linhas.map(async (id) => {
    const l = linhaPorId(id);
    const foto = await getImage({ src: img(l.pro.foto), width: 360, format: 'webp' });
    return {
      id, nome: nomeLinha(l), tipo: l.tipo, href: urlLinha(l), foto: foto.src,
      /* Ordem pedida pelo cliente: da entrada à PRO. */
      versoes: [...l.versoes].reverse().map((v) => ({ nome: v.nome, href: urlModelo(l, v) })),
    };
  })),
})));
---
<style is:inline>
.sm-barra{position:relative;z-index:100;background:#fff;border-bottom:1px solid #E4E7E3;font-family:Poppins,system-ui,sans-serif;color:#0B0D0B}
.sm-barra.sm-fixo{position:fixed;inset:0 0 auto 0}
.sm-interno{box-sizing:border-box;display:flex;align-items:center;gap:clamp(20px,3vw,48px);max-width:calc(1240px + 2 * clamp(20px, 1rem + 3vw, 72px));height:92px;margin:0 auto;padding:0 clamp(20px,1rem + 3vw,72px)}
.sm-logo{flex:none;display:flex;align-items:center;min-height:44px}
.sm-logo img{display:block;height:28px;width:auto}
.sm-itens{display:flex;align-items:stretch;gap:clamp(4px,1.2vw,18px);height:100%;margin:0;padding:0;list-style:none}
.sm-item{position:static;display:flex;align-items:center}
.sm-gatilho{display:inline-flex;align-items:center;gap:6px;height:100%;min-height:44px;padding:0 6px;background:none;border:0;border-bottom:2px solid transparent;border-top:2px solid transparent;cursor:pointer;font:500 12px/1 Poppins,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#3A3F3A;text-decoration:none;white-space:nowrap}
.sm-gatilho svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:2;transition:transform .2s ease}
.sm-gatilho:hover,.sm-item.sm-aberto .sm-gatilho{color:#0B0D0B}
.sm-item.sm-ativo .sm-gatilho{color:#0B0D0B;border-bottom-color:#38A936}
.sm-item.sm-aberto .sm-gatilho svg{transform:rotate(180deg)}
.sm-gatilho:focus-visible,.sm-painel a:focus-visible,.sm-btn:focus-visible,.sm-logo:focus-visible,.sm-hamb:focus-visible,.sm-acordeao button:focus-visible{outline:2px solid #38A936;outline-offset:2px}
.sm-painel{position:absolute;left:0;right:0;top:100%;background:#fff;border-top:1px solid #E4E7E3;border-bottom:1px solid #E4E7E3;box-shadow:0 24px 40px -24px rgba(11,13,11,.35);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility 0s linear .18s}
.sm-item.sm-aberto .sm-painel{opacity:1;visibility:visible;transform:none;transition-delay:0s}
.sm-painel__interno{box-sizing:border-box;max-width:calc(1240px + 2 * clamp(20px, 1rem + 3vw, 72px));margin:0 auto;padding:28px clamp(20px,1rem + 3vw,72px) 32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:28px}
.sm-linha{display:grid;gap:10px;align-content:start}
.sm-linha__foto{display:block;aspect-ratio:16/9;background:#F6F7F5;border:1px solid #E4E7E3;border-radius:2px;overflow:hidden}
.sm-linha__foto img{display:block;width:100%;height:100%;object-fit:contain;padding:8px;box-sizing:border-box;transition:transform .3s ease}
.sm-linha__foto:hover img{transform:scale(1.04)}
.sm-linha__tipo{margin:4px 0 0;font:500 10px/1.4 Poppins,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#3A3F3A}
.sm-linha__nome{font:400 22px/1.1 Anton,Impact,sans-serif;text-transform:uppercase;letter-spacing:.02em;color:#0B0D0B;text-decoration:none}
.sm-linha__nome:hover{text-decoration:underline;text-decoration-color:#38A936;text-underline-offset:4px}
.sm-chips{display:flex;flex-wrap:wrap;gap:6px}
.sm-chips a{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid #D4D8D3;border-radius:2px;font:600 11px/1 Poppins,system-ui,sans-serif;letter-spacing:.1em;color:#0B0D0B;text-decoration:none}
.sm-chips a:hover{border-color:#0B0D0B;background:#F6F7F5}
.sm-grupo{display:grid;gap:2px;align-content:start}
.sm-grupo__titulo{margin:0 0 6px;font:500 10px/1.4 Poppins,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#3A3F3A}
.sm-grupo a{display:flex;align-items:center;min-height:40px;font:500 15px/1.3 Poppins,system-ui,sans-serif;color:#0B0D0B;text-decoration:none;border-bottom:1px solid #EEF0ED}
.sm-grupo a:hover{color:#2F9430}
.sm-acoes{flex:none;margin-left:auto;display:flex;align-items:center}
.sm-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;background:#38A936;color:#071008;font:700 12px/1 Poppins,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border-radius:2px;white-space:nowrap}
.sm-btn:hover{background:#2F9430}
.sm-hamb{display:none;flex-direction:column;justify-content:center;gap:6px;width:44px;height:44px;margin-left:auto;padding:0 11px;background:none;border:0;cursor:pointer}
.sm-hamb span{display:block;height:1.5px;background:#0B0D0B;transition:transform .2s ease}
.sm-hamb[aria-expanded="true"] span:first-child{transform:translateY(3.75px) rotate(45deg)}
.sm-hamb[aria-expanded="true"] span:last-child{transform:translateY(-3.75px) rotate(-45deg)}
.sm-movel{position:fixed;inset:64px 0 0 0;z-index:99;background:#fff;display:flex;flex-direction:column;font-family:Poppins,system-ui,sans-serif}
.sm-movel[hidden]{display:none}
.sm-movel__rolagem{flex:1;overflow-y:auto;padding:8px 16px 24px}
.sm-acordeao{border-bottom:1px solid #E4E7E3}
.sm-acordeao__topo{display:flex;align-items:center;justify-content:space-between}
.sm-acordeao__topo a{flex:1;padding:16px 0;font:400 28px/1.1 Anton,Impact,sans-serif;text-transform:uppercase;color:#0B0D0B;text-decoration:none}
.sm-acordeao__topo button{width:48px;height:48px;display:grid;place-items:center;background:none;border:0;cursor:pointer;color:#0B0D0B}
.sm-acordeao__topo button svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;transition:transform .2s ease}
.sm-acordeao__topo button[aria-expanded="true"] svg{transform:rotate(180deg)}
.sm-acordeao__corpo{padding:0 0 18px;display:grid;gap:16px}
.sm-acordeao__corpo[hidden]{display:none}
.sm-acordeao .sm-linha{grid-template-columns:96px 1fr;align-items:center;gap:4px 14px}
.sm-acordeao .sm-linha__foto{grid-row:span 3}
.sm-acordeao .sm-linha__tipo{margin:0}
.sm-acordeao .sm-linha__nome{font-size:20px}
.sm-movel__rodape{padding:14px 16px calc(14px + env(safe-area-inset-bottom,0px));border-top:1px solid #E4E7E3;background:#fff}
.sm-movel__rodape .sm-btn{width:100%;box-sizing:border-box;min-height:52px}
@media (max-width:1023px){.sm-gatilho{letter-spacing:.05em;padding:0 3px}.sm-btn{padding:0 16px}}
@media (max-width:899px){.sm-interno{height:64px}.sm-logo img{height:22px}.sm-itens,.sm-acoes{display:none}.sm-hamb{display:flex}}
@media (prefers-reduced-motion:reduce){.sm-painel,.sm-gatilho svg,.sm-hamb span,.sm-linha__foto img{transition:none}}
</style>

<header class:list={['sm-barra', { 'sm-fixo': fixo }]} data-menu-site>
  <div class="sm-interno">
    <a class="sm-logo" href="/" aria-label="EDRO, página inicial">
      <img src={logo.src} alt="EDRO" height="28" width={larguraLogo} />
    </a>

    <nav aria-label="Navegação principal" style="height:100%">
      <ul class="sm-itens">
        {itens.map((m) => (
          <li class:list={['sm-item', { 'sm-ativo': m.ativo }]} data-item>
            <button class="sm-gatilho" type="button" aria-expanded="false" aria-controls={`sm-painel-${m.id}`}>
              {m.rotulo}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg>
            </button>
            <div class="sm-painel" id={`sm-painel-${m.id}`}>
              <div class="sm-painel__interno">
                {m.linhas?.map((l) => (
                  <div class="sm-linha">
                    <a class="sm-linha__foto" href={l.href} tabindex="-1" aria-hidden="true"><img src={l.foto} alt="" loading="lazy" decoding="async" /></a>
                    <p class="sm-linha__tipo">{l.tipo}</p>
                    <a class="sm-linha__nome" href={l.href}>{l.nome}</a>
                    <div class="sm-chips" aria-label={`Versões da ${l.nome}`}>
                      {l.versoes.map((v) => <a href={v.href} aria-label={`${l.nome} ${v.nome}`}>{v.nome}</a>)}
                    </div>
                  </div>
                ))}
                {m.grupos?.map((g) => (
                  <div class="sm-grupo">
                    {g.titulo && <p class="sm-grupo__titulo">{g.titulo}</p>}
                    {g.links.map(([t, h]) => <a href={h}>{t}</a>)}
                  </div>
                ))}
                <div class="sm-grupo">
                  <a href={m.href}>{m.id === 'bikes' ? 'Ver todas as bikes' : m.id === 'ebikes' ? 'Ver a linha HORIZON' : m.id === 'monte' ? 'Como funciona o FIT4U' : 'Todos os diferenciais'} →</a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="sm-acoes">
      <a class="sm-btn" href={LOJISTA.href}>{LOJISTA.rotulo}</a>
    </div>

    <button class="sm-hamb" type="button" aria-expanded="false" aria-controls="sm-movel" aria-label="Abrir menu">
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="sm-movel" id="sm-movel" hidden>
  <nav class="sm-movel__rolagem" aria-label="Navegação mobile">
    {itens.map((m) => (
      <div class="sm-acordeao">
        <div class="sm-acordeao__topo">
          <a href={m.href}>{m.rotulo}</a>
          <button type="button" aria-expanded="false" aria-controls={`sm-acord-${m.id}`} aria-label={`Abrir ${m.rotulo}`}>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg>
          </button>
        </div>
        <div class="sm-acordeao__corpo" id={`sm-acord-${m.id}`} hidden>
          {m.linhas?.map((l) => (
            <div class="sm-linha">
              <a class="sm-linha__foto" href={l.href} tabindex="-1" aria-hidden="true"><img src={l.foto} alt="" loading="lazy" decoding="async" /></a>
              <p class="sm-linha__tipo">{l.tipo}</p>
              <a class="sm-linha__nome" href={l.href}>{l.nome}</a>
              <div class="sm-chips">{l.versoes.map((v) => <a href={v.href} aria-label={`${l.nome} ${v.nome}`}>{v.nome}</a>)}</div>
            </div>
          ))}
          {m.grupos?.map((g) => (
            <div class="sm-grupo">
              {g.titulo && <p class="sm-grupo__titulo">{g.titulo}</p>}
              {g.links.map(([t, h]) => <a href={h}>{t}</a>)}
            </div>
          ))}
        </div>
      </div>
    ))}
  </nav>
  <div class="sm-movel__rodape">
    <a class="sm-btn" href={LOJISTA.href}>{LOJISTA.rotulo}</a>
  </div>
</div>

<script is:inline>
(function () {
  var barra = document.querySelector('[data-menu-site]');
  if (!barra) return;
  var itens = [].slice.call(barra.querySelectorAll('[data-item]'));
  var hover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var fechar = function (item) { item.classList.remove('sm-aberto'); item.querySelector('.sm-gatilho').setAttribute('aria-expanded', 'false'); };
  var abrir = function (item) { itens.forEach(function (i) { if (i !== item) fechar(i); }); item.classList.add('sm-aberto'); item.querySelector('.sm-gatilho').setAttribute('aria-expanded', 'true'); };
  itens.forEach(function (item) {
    var gatilho = item.querySelector('.sm-gatilho');
    var timer;
    gatilho.addEventListener('click', function () { item.classList.contains('sm-aberto') ? fechar(item) : abrir(item); });
    if (hover) {
      item.addEventListener('mouseenter', function () { clearTimeout(timer); timer = setTimeout(function () { abrir(item); }, 90); });
      item.addEventListener('mouseleave', function () { clearTimeout(timer); timer = setTimeout(function () { fechar(item); }, 160); });
    }
    /* Foco saiu do item (Tab adiante): fecha. */
    item.addEventListener('focusout', function (e) { if (!item.contains(e.relatedTarget)) fechar(item); });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var aberto = itens.filter(function (i) { return i.classList.contains('sm-aberto'); })[0];
    if (aberto) { fechar(aberto); aberto.querySelector('.sm-gatilho').focus(); }
  });
  document.addEventListener('click', function (e) { if (!barra.contains(e.target)) itens.forEach(fechar); });

  /* Celular: tela cheia com acordeão. */
  var hamb = barra.querySelector('.sm-hamb');
  var movel = document.getElementById('sm-movel');
  if (hamb && movel) {
    var fecharMovel = function () { hamb.setAttribute('aria-expanded', 'false'); hamb.setAttribute('aria-label', 'Abrir menu'); movel.hidden = true; document.body.style.overflow = ''; };
    hamb.addEventListener('click', function () {
      var abre = hamb.getAttribute('aria-expanded') !== 'true';
      if (!abre) return fecharMovel();
      hamb.setAttribute('aria-expanded', 'true'); hamb.setAttribute('aria-label', 'Fechar menu'); movel.hidden = false; document.body.style.overflow = 'hidden';
    });
    movel.querySelectorAll('.sm-acordeao__topo button').forEach(function (b) {
      b.addEventListener('click', function () {
        var corpo = document.getElementById(b.getAttribute('aria-controls'));
        var abre = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(abre)); corpo.hidden = !abre;
      });
    });
    movel.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) fecharMovel(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !movel.hidden) { fecharMovel(); hamb.focus(); } });
    window.addEventListener('resize', function () { if (window.innerWidth > 899 && !movel.hidden) fecharMovel(); });
  }
})();
</script>
