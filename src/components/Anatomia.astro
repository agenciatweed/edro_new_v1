---
/* =============================================================
   "Peça por peça": a PRO da linha fica parada na tela enquanto a
   pessoa rola, e cada componente da ficha do catálogo acende na foto.
   A câmera aproxima do componente da vez; o peso conta até o valor
   do catálogo. Prova antes de promessa: só dados da ficha, nada inventado.

   Sem JavaScript (ou com movimento reduzido): foto inteira, todos os
   marcadores visíveis e a lista completa, sem zoom nem contagem.
   ============================================================= */
import { Picture } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { junto, pesoTexto } from '../lib/edro.js';
import pontos from '../content/anatomia.json';

const { linha, horizon = false, sistema = {} } = Astro.props;
const pro = linha.pro;
const mapa = pontos[pro.chave];
const nome = horizon ? `${linha.nome} HORIZON` : linha.nome;
const ficha = Object.fromEntries(pro.ficha);
const ROTULO = { Bateria: 'EDRO Power Pack' };
const passos = [
  { titulo: 'Peso', texto: `${pro.peso_texto} completa, sem pedais, no tamanho M.`, x: 50, y: 50 },
  ...Object.entries(mapa ?? {}).map(([item, [x, y]]) => ({
    titulo: ROTULO[item] ?? item,
    texto: ficha[item] ?? sistema[item] ?? '',
    x, y,
  })).filter((p) => p.texto),
];
const [inteiro, decimal] = pesoTexto(pro).split(',');
---
{mapa && (
<section class="secao anatomia" data-anatomia aria-labelledby={`anatomia-${linha.slug}`}>
  <div class="container">
    <h2 class="headline anatomia__titulo" id={`anatomia-${linha.slug}`}>A <i class="modelo">{linha.nome}</i>{horizon ? ' HORIZON' : ''} PRO,<br />peça por <span class="verde">peça.</span></h2>
  </div>
  <div class="container anatomia__grade">
    <div class="anatomia__palco">
      <div class="anatomia__camera" data-camera>
        <Picture src={img(pro.foto)} formats={['avif', 'webp']} alt={`EDRO ${nome} PRO 2027, vista lateral`}
          widths={[960, 1600, 2000]} sizes="(max-width: 1023px) 100vw, 60vw" loading="lazy" />
        {passos.slice(1).map((p, i) => (
          <span class="anatomia__ponto" style={`left:${p.x}%;top:${p.y}%`} data-ponto={i + 1} aria-hidden="true"><span>{i + 1}</span></span>
        ))}
      </div>
      <p class="anatomia__peso" aria-hidden="true">
        <span data-conta={pro.peso_kg} data-casas={decimal?.length ?? 0}>{inteiro},{decimal}</span><small>kg</small>
      </p>
    </div>
    <ol class="anatomia__passos">
      {passos.map((p, i) => (
        <li class="anatomia__passo" data-passo={i} data-x={p.x} data-y={p.y}>
          {i > 0 && <span class="anatomia__num" aria-hidden="true">{i}</span>}
          <h3>{p.titulo}</h3>
          <p>{junto(p.texto)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-anatomia]').forEach((secao) => {
    const camera = secao.querySelector<HTMLElement>('[data-camera]');
    const passos = [...secao.querySelectorAll<HTMLElement>('.anatomia__passo')];
    const pontosEl = [...secao.querySelectorAll<HTMLElement>('[data-ponto]')];
    const conta = secao.querySelector<HTMLElement>('[data-conta]');
    if (!camera || !passos.length) return;
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    secao.classList.add('anatomia--viva');
    if (calmo) secao.classList.add('anatomia--calma');

    /* Peso: conta de 0 ao valor do catálogo na primeira vez que a seção aparece. */
    const contar = () => {
      if (!conta || calmo) return;
      const alvo = Number(conta.dataset.conta);
      const casas = Number(conta.dataset.casas);
      const t0 = performance.now();
      const dur = 1600;
      const passo = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const v = alvo * (1 - Math.pow(1 - k, 4));
        conta.textContent = v.toFixed(casas).replace('.', ',');
        if (k < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { contar(); o.disconnect(); } }, { threshold: 0.35 }).observe(secao);

    /* O passo no meio da tela acende o ponto e leva a câmera até ele. */
    const ativar = (i: number) => {
      passos.forEach((p, j) => p.classList.toggle('ativo', i === j));
      pontosEl.forEach((p) => p.classList.toggle('ativo', Number(p.dataset.ponto) === i));
      const p = passos[i];
      const zoom = i === 0 || calmo ? 1 : 1.85;
      camera.style.setProperty('--ox', `${p.dataset.x}%`);
      camera.style.setProperty('--oy', `${p.dataset.y}%`);
      camera.style.setProperty('--zoom', String(zoom));
      secao.dataset.passo = String(i);
    };
    ativar(0);
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((en) => { if (en.isIntersecting) ativar(Number((en.target as HTMLElement).dataset.passo)); });
    /* No computador, o passo do meio da tela; no celular, a foto fica parada em cima
       e o passo ativo é o que aparece logo abaixo dela. */
    }, { rootMargin: matchMedia('(max-width: 1023px)').matches ? '-58% 0px -30% 0px' : '-48% 0px -48% 0px' });
    passos.forEach((p) => obs.observe(p));
  });
</script>
