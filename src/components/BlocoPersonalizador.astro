---
/* =============================================================
   Bloco do personalizador de pintura FIT4U (v3.2).
   - home: "Pinte a sua EDRO antes de ela existir" com as três frases (seção 5.2).
   - fit4u: o mesmo título, o texto da seção 4.6 e as etiquetas do que dá para montar.
   A captura real do personalizador: desktop no computador, mobile no celular.
   Sempre leva ao personalizador como página inteira, nunca em iframe.
   ============================================================= */
import { Picture } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { PERSONALIZADOR } from '../lib/edro.js';

const { variante = 'home' } = Astro.props;
const home = variante === 'home';
/* v3.3 §6.7 (home) e §11.4 (FIT4U). */
const frases = [
  'Escolha entre diversos modelos com visualização real do quadro.',
  'Combine paletas de cores, grafismos exclusivos, diferentes acabamentos e adicione a sua assinatura.',
  'Receba o projeto em PDF e a imagem em alta na hora; nossa equipe de design revisa e valida cada detalhe diretamente com você.',
];
const alt = 'Personalizador de pintura FIT4U com a SUMMA HORIZON PRO verde em foto no local';
const seta = '<svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<section class="secao" id="personalizador">
  <div class="container personalizador">
    <a class="personalizador__captura" href={PERSONALIZADOR} tabindex="-1" aria-hidden="true">
      <span class="personalizador__desktop"><Picture src={img('fit4u/fit4u-desktop.png')} formats={['avif', 'webp']} alt=""
        widths={[720, 1080, 1440]} sizes="(max-width: 1023px) 100vw, 52vw" loading="lazy" /></span>
      <span class="personalizador__mobile"><Picture src={img('fit4u/fit4u-mobile.png')} formats={['avif', 'webp']} alt=""
        widths={[430, 645]} sizes="80vw" loading="lazy" /></span>
    </a>
    <span class="visualmente-oculto">{alt}</span>
    <div>
      <p class="eyebrow eyebrow--verde">{home ? 'Personalizador FIT4U' : 'Personalizador de pintura'}</p>
      <h2 class="headline" style="margin-top:var(--s-4)">Dando vida à<br />sua <span class="verde">EDRO.</span></h2>
      {home ? (
        <ul class="personalizador__frases">
          {frases.map((t) => <li>{t}</li>)}
        </ul>
      ) : (
        <p class="lead">Escolha entre diversos modelos com visualização real do quadro e combine paletas de cores, grafismos exclusivos e diferentes acabamentos até adicionar a sua assinatura. Ao finalizar, você receberá o projeto em PDF com uma imagem em alta resolução, enquanto a nossa equipe de design revisa e valida cada detalhe diretamente com você.</p>
      )}
      <div class="personalizador__acoes">
        <a class="btn btn--primario" href={PERSONALIZADOR} data-personalizar={`bloco-${variante}`}>{home ? 'Personalize a sua EDRO' : 'Simule a sua pintura'}<Fragment set:html={seta} /></a>
        {home && <a class="link-seta" href="/fit4u#aprovacao">Entenda o processo de aprovação</a>}
      </div>
    </div>
  </div>
</section>
