---
/* Card de plataforma (12.4). Usado na home e em /bikes.
   Nome em imagem de wordmark: decisão do cliente para esta seção.
   Peso e preço vêm do bikes.json, nunca digitados aqui. */

import { Image, Picture } from 'astro:assets';
import { kg, brl } from '../lib/edro.js';

import bikeSumma   from '../assets/bicicletas/bicicleta-summa.png';
import bikeRange   from '../assets/bicicletas/bicicleta-range.png';
import bikeImpetus from '../assets/bicicletas/bicicleta-impetus.png';
import nomeSumma   from '../assets/nomes/nome-summa.png';
import nomeRange   from '../assets/nomes/nome-range.png';
import nomeImpetus from '../assets/nomes/nome-impetus.png';
import modeloPro   from '../assets/nomes/modelo-pro.png';

const renders   = { summa: bikeSumma, range: bikeRange, impetus: bikeImpetus };
const wordmarks = { summa: nomeSumma, range: nomeRange, impetus: nomeImpetus };

const { p } = Astro.props;
---

<article class="card-plataforma">
  <a class="card-plataforma__link" href={`/bikes/${p.slug}`} aria-label={`${p.nome} ${p.pro.nome}, ver plataforma`}>
    <p class="eyebrow">{p.uso_curto}</p>
    <p class="card-plataforma__nome">
      <Image class="card-plataforma__wordmark" src={wordmarks[p.slug]} alt={p.nome} height={24} densities={[1, 2]} />
      <Image class="card-plataforma__selo" src={modeloPro} alt={p.pro.nome} height={16} densities={[1, 2]} />
    </p>
  </a>

  <Picture
    pictureAttributes={{ class: 'card-plataforma__render' }}
    src={renders[p.slug]}
    formats={['avif', 'webp']}
    alt={`EDRO ${p.nome} ${p.pro.nome} de carbono, vista lateral esquerda`}
    widths={[400, 800, 1200]}
    sizes="(max-width: 767px) 90vw, 33vw"
    loading="lazy"
  />

  <div class="card-plataforma__rodape">
    <div class="card-plataforma__bloco">
      <p class="metric-stat">{kg(p.pro.peso_kg)}<span class="unidade"> kg</span></p>
      <span class="caption card-plataforma__rotulo">versão {p.pro.nome}</span>
    </div>
    <div class="card-plataforma__bloco">
      <p class="card-plataforma__preco">{brl(p.entrada.preco)}</p>
      <span class="caption card-plataforma__rotulo">a partir de, versão {p.entrada.nome}</span>
    </div>
    <svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </div>
</article>
