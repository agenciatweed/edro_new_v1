---
/* =============================================================
   Card de um modelo (uma versão), v3.3 · referencias/ref-cards-modelos.png.
   v4: logo na fonte EDRO, centralizada; botão "Personalize".
   Ajuste 3: embaixo da foto só a logo da linha (com HORIZON nas elétricas) e a
   versão (EX, XCR, PRO…) em cinza no canto superior direito do card.
   Foto sobre branco, nome da linha + versão, peso e preço exatos, e dois
   botões: "Saiba mais" (página do modelo) e "Pinte a sua" (personalizador
   já na linha e na versão). A IMPETUS SS ainda não está no personalizador:
   "Pinte a sua" abre o WhatsApp de pintura.
   ============================================================= */
import { Picture } from 'astro:assets';
import LogoBike from './LogoBike.astro';
import { img } from '../lib/imagens.js';
import { brl, wa, pesoTexto, urlModelo, nomeLinha, ehHorizon } from '../lib/edro.js';

const { linha, versao: v, compacto = false, titulo = 'h3' } = Astro.props;
const Tag = titulo;
const horizon = ehHorizon(linha);
const nome = `${nomeLinha(linha)} ${v.nome}`;
const saibaMais = urlModelo(linha, v);
const pintar = v.personalizar
  ?? wa(`Olá, EDRO. Quero falar sobre a pintura da minha ${nome}. (origem: site-${linha.slug}-${v.slug}-pintura)`);
---
<article class:list={['card-modelo', { 'card-modelo--compacto': compacto }]}>
  <span class="logo-versao card-modelo__versao" aria-hidden="true">{v.nome}</span>
  <a class="card-modelo__foto" href={saibaMais} tabindex="-1" aria-hidden="true">
    <Picture src={img(v.foto)} formats={['avif', 'webp']} alt="" widths={[480, 800]}
      sizes="(max-width: 767px) 80vw, (max-width: 1279px) 34vw, 300px" loading="lazy" />
  </a>
  <Tag class="card-modelo__nome">
    <a href={saibaMais}>
      <span class="visualmente-oculto">{nome}</span>
      <LogoBike linha={linha} />
    </a>
  </Tag>
  <p class="card-modelo__dados">
    <span>{pesoTexto(v)}&nbsp;kg <small class="card-modelo__sp">sem pedais</small> · {brl(v.preco)}</span>
    <span class="card-modelo__parcela">{v.parcelamento}</span>
  </p>
  <div class="card-modelo__botoes">
    <a class="btn btn--secundario" href={saibaMais} aria-label={`Saiba mais sobre a ${nome}`}>Saiba mais</a>
    <a class="btn btn--primario" href={pintar} rel={v.personalizar ? undefined : 'noopener'}
       data-personalizar={v.personalizar ? v.chave : undefined} data-wa={v.personalizar ? undefined : `pintura-${linha.slug}-${v.slug}`}
       aria-label={`Personalize a sua ${nome}`}>Personalize</a>
  </div>
</article>
