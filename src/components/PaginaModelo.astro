---
/* =============================================================
   Página de modelo (v3.3 §9): uma por versão. Usada pelas linhas
   convencionais (/bikes/<linha>/<versao>) e pelas HORIZON
   (/horizon/<linha>/<versao>, §15.6), com a geometria do quadro base.
   Tudo do catálogo 2027 (lib/edro.js → plataformas[].versoes[]).
   Hero branco com a bike; destaques, ficha completa, critérios de
   escolha dos componentes, geometria e condições no escuro; outras
   versões da linha no branco; fechamento.
   v4: logo na fonte EDRO, "Quero a minha" antes de "Personalize", sem o
   bloco de destaques, ficha nova do cliente (sem o "A ficha da …"),
   "O que só a EDRO entrega" e outras versões sem a nota de rodapé.
   ============================================================= */
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import LogoBike from '../components/LogoBike.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Pilares from '../components/Pilares.astro';
import GeometriaGrade from '../components/GeometriaGrade.astro';
import Condicoes from '../components/Condicoes.astro';
import CardModelo from '../components/CardModelo.astro';
import Fechamento from '../components/Fechamento.astro';
import { img } from '../lib/imagens.js';
import { brl, wa, junto, pesoTexto, rodapeFicha, porSlug, ehHorizon, nomeLinha, urlLinha, urlModelo } from '../lib/edro.js';

const { p, v } = Astro.props;
const horizon = ehHorizon(p);
const nomeL = nomeLinha(p);
const nome = `${nomeL} ${v.nome}`;
const url = `https://edrobikes.com.br${urlModelo(p, v)}`;
/* A HORIZON tem a geometria do quadro da SUMMA ou da RANGE. */
const geoP = horizon ? porSlug(p.base) : p;
const irmas = p.versoes.filter((x) => x.slug !== v.slug);
const pintar = v.personalizar ?? wa(`Olá, EDRO. Quero falar sobre a pintura da minha ${nome}. (origem: site-${p.slug}-${v.slug}-pintura)`);
const quero = wa(`Olá, EDRO. Tenho interesse na ${nome}. Minha bike atual é: ___ (origem: site-${p.slug}-${v.slug})`);
const seta = '<svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';

/* Ficha do cliente (v4), na ordem e com os textos dele. */
const ficha = v.ficha;
const temAutonomia = ficha.some(([k]) => k === 'Autonomia');
const metade = Math.ceil(ficha.length / 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `EDRO ${nome}`,
    description: v.resumo,
    sku: v.chave,
    brand: { '@type': 'Brand', name: 'EDRO Performance Bikes' },
    category: p.tipo,
    image: 'https://edrobikes.com.br/og-edro.png',
    weight: { '@type': 'QuantitativeValue', value: v.peso_kg, unitCode: 'KGM' },
    offers: { '@type': 'Offer', price: v.preco, priceCurrency: 'BRL', availability: 'https://schema.org/PreOrder', url },
  },
];
---

<Base
  titulo={`EDRO ${nome} · ${p.tipo} de carbono, ${v.peso_texto}`}
  descricao={`${junto(v.resumo)} ${v.peso_texto} sem pedais, ${brl(v.preco)} ${v.parcelamento}.`}
  canonica={url}
  pagina={`${p.slug}-${v.slug}`}
  jsonLd={jsonLd}
>

<section class="secao secao--clara modelo-hero">
  <div class="container">
    <nav class="trilha-pao" aria-label="Você está em">
      {horizon ? <a href="/horizon">E-Bikes</a> : <a href="/bikes">Bikes</a>}<span aria-hidden="true">/</span><a href={urlLinha(p)}><i class="modelo">{p.nome}</i>{horizon && ' HORIZON'}</a><span aria-hidden="true">/</span><span aria-current="page">{v.nome}</span>
    </nav>
    <div class="modelo-hero__grade">
      <div class="modelo-hero__foto">
        <Picture src={img(v.foto)} formats={['avif', 'webp']} alt={`EDRO ${nome} 2027, vista lateral`}
          widths={[800, 1200, 1600]} sizes="(max-width: 1023px) 100vw, 58vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="modelo-hero__texto">
        <p class="eyebrow">{p.tipo}</p>
        <h1 class="modelo-hero__nome">
          <span class="visualmente-oculto">EDRO {nome}</span>
          <LogoBike linha={p} versao={v} />
        </h1>
        <p class="modelo-hero__resumo">{junto(v.resumo)}</p>
        <dl class="modelo-hero__dados">
          <div><dt>Peso</dt><dd><b>{pesoTexto(v)}&nbsp;kg</b><span>sem pedais, tamanho M</span></dd></div>
          <div><dt>Preço</dt><dd><b>{brl(v.preco)}</b><span>{v.parcelamento} no cartão, ou 5% de desconto no Pix</span></dd></div>
        </dl>
        <div class="modelo-hero__botoes">
          <a class="btn btn--secundario" href={quero} rel="noopener" data-wa={`modelo-${p.slug}-${v.slug}`}>Quero a minha</a>
          <a class="btn btn--primario" href={pintar} rel={v.personalizar ? undefined : 'noopener'} data-wa={v.personalizar ? undefined : `pintura-${p.slug}-${v.slug}`}>Personalize<Fragment set:html={seta} /></a>
        </div>
        <nav class="modelo-hero__versoes" aria-label={`Versões da ${nomeL}`}>
          {p.versoes.map((x) => (
            <a href={urlModelo(p, x)} aria-current={x.slug === v.slug ? 'page' : undefined}>{x.nome}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</section>

<section class="secao" id="especificacoes">
  <div class="container">
    <Cabecalho linhas={['Especificações']} verde="completas." />
    <div class="modelo-ficha">
      {[ficha.slice(0, metade), ficha.slice(metade)].map((parte, i) => (
        <table class="tabela modelo-ficha__tabela">
          <caption class="visualmente-oculto">Especificações da {nome}, parte {i + 1}</caption>
          <tbody>
            {parte.map(([k, val]) => (<tr><th scope="row">{k}</th><td>{junto(val)}</td></tr>))}
          </tbody>
        </table>
      ))}
    </div>
    {temAutonomia && <p class="nota-peso" style="margin-top:var(--s-3)">*A autonomia varia de acordo com o terreno, peso e pilotagem. Consulte o <a href="/horizon/simulador">Simulador EDRO</a>.</p>}
    {rodapeFicha.slice(0, 2).map((t) => <p class="nota-peso" style="margin-top:var(--s-3)">{t}</p>)}
  </div>
</section>

<Pilares />

<GeometriaGrade p={geoP} />

<Condicoes linhas={['O que só a EDRO']} verde="entrega." />

<section class="secao secao--clara" id="outras-versoes">
  <div class="container">
    <h2 class="headline">Outras versões da <i class="modelo">{p.nome}</i>{horizon && ' HORIZON'}.</h2>
    <div class="modelo-irmas">
      {irmas.map((x) => <CardModelo linha={p} versao={x} />)}
    </div>
    <a class="link-seta link-seta--limpo" href={urlLinha(p)}>Ver toda a linha <i class="modelo">{p.nome}</i>{horizon && ' HORIZON'}</a>
  </div>
</section>

<Fechamento linhas={['Fuja do']} verde="comum."
  texto="Fale diretamente com os especialistas que desenvolvem a sua bike."
  botoes={[
    { rotulo: 'Falar com um especialista', href: wa(`Olá, EDRO. Quero falar com um especialista sobre a ${nome}. (origem: site-${p.slug}-${v.slug}-fechamento)`), primario: true, wa: `fechamento-${p.slug}-${v.slug}` },
    { rotulo: 'Ver todas as bikes', href: '/bikes' },
  ]} />

</Base>
