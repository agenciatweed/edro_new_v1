---
/* =============================================================
   Bloco de uma linha em fundo branco (v3.3, §5.4): tipo, nome da linha,
   frase curta, "a partir de" de peso e preço (do dado) e "Conheça a …",
   com os cards de modelo da linha embaixo.
   v4: logo na fonte EDRO, sem o "a partir de" e "Conheça a …" sem sublinhado.
   ============================================================= */
import LogoBike from './LogoBike.astro';
import { urlLinha, nomeLinha } from '../lib/edro.js';
import CarrosselModelos from './CarrosselModelos.astro';

const { linha, conheca, conhecaHref, h = 'h3' } = Astro.props;
const Tag = h;
const nome = nomeLinha(linha);
const destino = conhecaHref ?? urlLinha(linha);
const rotuloConheca = conheca ?? `Conheça a ${nome}`;
const modelo = (s) => s.replace(/\b(SUMMA|RANGE|IMPETUS)\b/g, '<i class="modelo">$1</i>');
---
<div class="linha-clara" id={`linha-${linha.slug}`}>
  <div class="linha-clara__topo">
    <div>
      <p class="eyebrow">{linha.tipo}</p>
      <Tag class="linha-clara__nome">
        <span class="visualmente-oculto">{nome}</span>
        <LogoBike linha={linha} />
      </Tag>
    </div>
    <div class="linha-clara__texto">
      <p set:html={`${modelo(linha.para_quem)}.`} />
      <a class="link-seta link-seta--limpo" href={destino} set:html={modelo(rotuloConheca)} />
    </div>
  </div>
  <CarrosselModelos itens={linha.versoes.map((v) => ({ linha, versao: v }))} rotulo={`Modelos da ${nome}`} />
</div>
