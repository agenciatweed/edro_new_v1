---
/* Sub-abas da seção E-Bikes (v3.4 Kit HORIZON, §1 e §2.1): HORIZON, SUMMA HORIZON,
   RANGE HORIZON, Simulador de autonomia e, sempre por último, Kit HORIZON.
   É o único lugar do site (fora o rodapé e o FAQ) que leva ao Kit HORIZON. */
const ITENS = [
  ['HORIZON', '/horizon'],
  ['<i class="modelo">SUMMA</i>&nbsp;HORIZON', '/horizon/summa-horizon'],
  ['<i class="modelo">RANGE</i>&nbsp;HORIZON', '/horizon/range-horizon'],
  ['Simulador de autonomia', '/horizon/simulador'],
  ['Kit HORIZON', '/horizon/kit-horizon'],
];
const atual = (Astro.url.pathname.replace(/\/$/, '') || '/');
---
<nav class="sub-abas" aria-label="Seção E-Bikes">
  <div class="container sub-abas__interno">
    {ITENS.map(([rotulo, href]) => (
      <a href={href} aria-current={atual === href ? 'page' : undefined} set:html={rotulo} />
    ))}
  </div>
</nav>
