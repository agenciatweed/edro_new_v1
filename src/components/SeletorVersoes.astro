---
/* =============================================================
   Seletor de versões v3.2 (telas site_v3_2/17 e 18). Tudo vem do
   catálogo 2027 via lib/edro.js: nome com a versão em verde, resumo,
   foto lateral oficial, destaques, preço com "em até 12x sem juros",
   peso com a nota e três botões: "Quero a minha", "Ver especificações
   completas" (a ficha do catálogo num <dialog>) e "Personalize a
   pintura" (personalizador FIT4U na versão em tela). A IMPETUS SS
   ainda não está no personalizador: no lugar, "Falar sobre a pintura".
   Ao lado, a ficha resumida. Tabs com ARIA, teclado e âncora na URL.
   ============================================================= */
import { Image, Picture } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { brl, wa, junto, pesoTexto, rodapeFicha } from '../lib/edro.js';
import Cabecalho from './Cabecalho.astro';

const { linha, wordmark, horizon = false, lead } = Astro.props;
const nomeCompleto = horizon ? `${linha.nome} HORIZON` : linha.nome;
const idBase = linha.slug;
/* Na página, a ficha resumida; no modal, a ficha inteira do catálogo. */
const FORA_DO_RESUMO = ['Peso', 'Cockpit', 'Selim e manoplas', 'Selim'];
/* "8,47 kg" vira número grande + unidade; "XX SL AXS" vira "XX" + "SL AXS"; texto puro fica inteiro. */
const destaque = (d) => {
  const n = d.valor.match(/^([\d.,]+)\s*(.*)$/);
  if (n) return { num: n[1], uni: n[2] };
  const t = d.valor.match(/^(\S{1,3})\s+(.+)$/);
  return t ? { num: t[1], uni: t[2] } : { num: d.valor, uni: '', texto: true };
};
---
<section class="secao" id="versoes">
  <div class="container">
    <Cabecalho eyebrow="Versões" linhas={['Três versões.', 'O mesmo']} verde=" quadro."
      lead={lead ?? `Todas partem do mesmo quadro <i class="modelo">${linha.nome}</i>${horizon ? ' HORIZON' : ''} em carbono, da mesma pintura exclusiva e da mesma garantia vitalícia. O que muda são os componentes.`} />

    <div class="versoes__tabs" role="tablist" aria-label={`Versões da ${nomeCompleto}`}>
      {linha.versoes.map((v, i) => (
        <button class="versoes__tab" role="tab" type="button" id={`tab-${idBase}-${v.slug}`} aria-controls={`painel-${idBase}-${v.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-versao={v.slug}>{v.nome}</button>
      ))}
    </div>

    {linha.versoes.map((v, i) => (
      <div class="versao" role="tabpanel" id={`painel-${idBase}-${v.slug}`} aria-labelledby={`tab-${idBase}-${v.slug}`} hidden={i !== 0}>
        <div>
          <h3 class="versao__nome">
            <span class="visualmente-oculto">{nomeCompleto} {v.nome}</span>
            <Image src={img(`brand/${wordmark}.png`)} alt="" height={52} />
            {horizon && <Image src={img('brand/horizon.png')} alt="" height={40} />}
            <Image src={img(`brand/${v.slug}.png`)} alt="" height={46} />
          </h3>
          <p class="lead versao__resumo">{junto(v.resumo)}</p>
          <div class="versao__foto">
            <Picture src={img(v.foto)} formats={['avif', 'webp']} alt={`EDRO ${nomeCompleto} ${v.nome} 2027, vista lateral`}
              widths={[800, 1600]} sizes="(max-width: 1023px) 100vw, 55vw" loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class:list={['versao__destaques', { 'versao__destaques--quatro': v.destaques.length > 3 }]}>
            {v.destaques.map((d) => {
              const x = destaque(d);
              return (
                <div>
                  <p class:list={['versao__destaque', { 'versao__destaque--texto': x.texto }]}>{x.num}{x.uni && <span class="versao__destaque-uni">{x.uni}</span>}</p>
                  <span class="caption">{junto(d.legenda)}</span>
                </div>
              );
            })}
          </div>
          <div class="versao__stats">
            <div>
              <p class="metric-stat">{pesoTexto(v)}<span class="unidade">&nbsp;kg</span></p>
              <span class="caption">sem pedais, tamanho M</span>
            </div>
            <div>
              <p class="metric-stat">{brl(v.preco)}</p>
              <span class="caption">{v.parcelamento} no cartão, ou 5% de desconto no Pix</span>
            </div>
          </div>
          <div class="versao__botoes">
            <a class="btn btn--primario" rel="noopener" data-wa={`versao-${idBase}-${v.slug}`}
               href={wa(`Olá, EDRO. Tenho interesse na ${nomeCompleto} ${v.nome}. Minha bike atual é: ___ (origem: site-${idBase}-${v.slug})`)}>
              Quero a minha {nomeCompleto} {v.nome}
              <svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <button class="btn btn--secundario" type="button" data-abre-ficha={`ficha-${idBase}-${v.slug}`}>Ver especificações completas</button>
            {v.personalizar ? (
              <a class="btn btn--contorno" href={v.personalizar} data-personalizar={`${idBase}-${v.slug}`}>Personalize a pintura</a>
            ) : (
              <a class="btn btn--contorno" rel="noopener" data-wa={`pintura-${idBase}-${v.slug}`}
                 href={wa(`Olá, EDRO. Quero falar sobre a pintura da minha ${nomeCompleto} ${v.nome}. (origem: site-${idBase}-${v.slug}-pintura)`)}>Falar sobre a pintura</a>
            )}
          </div>
        </div>
        <dl class="versao__specs">
          {v.ficha.filter(([k]) => !FORA_DO_RESUMO.includes(k)).map(([k, val]) => (<div><dt>{k}</dt><dd>{junto(val)}</dd></div>))}
        </dl>

        <dialog class="ficha-modal" id={`ficha-${idBase}-${v.slug}`} aria-labelledby={`ficha-${idBase}-${v.slug}-t`}>
          <div class="ficha-modal__topo">
            <h2 class="card-title" id={`ficha-${idBase}-${v.slug}-t`}><i class="modelo">{linha.nome}</i>{horizon && ' HORIZON'} <span class="verde">{v.nome}</span></h2>
            <button class="ficha-modal__fechar" type="button" data-fecha-ficha aria-label="Fechar especificações">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <div class="ficha-modal__corpo">
            <table class="tabela">
              <caption class="visualmente-oculto">Especificações completas da {nomeCompleto} {v.nome}</caption>
              <tbody>
                {v.ficha.map(([k, val]) => (<tr><th scope="row">{k}</th><td>{k === 'Peso' ? `${junto(val)}, sem pedais, tamanho M` : junto(val)}</td></tr>))}
                <tr><th scope="row">Preço</th><td>{brl(v.preco)}, {v.parcelamento}</td></tr>
              </tbody>
            </table>
            {rodapeFicha.map((t) => <p class="nota-peso">{t}</p>)}
          </div>
        </dialog>
      </div>
    ))}

    <p class="nota-peso">{rodapeFicha.join(' ')}</p>
  </div>
</section>

<script>
  document.querySelectorAll('[role="tablist"]').forEach((lista) => {
    const tabs = [...lista.querySelectorAll('[role="tab"]')];
    const paineis = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') || ''));
    const mostrar = (i, focar = true, url = true) => {
      tabs.forEach((t, j) => {
        const ativo = i === j;
        t.setAttribute('aria-selected', ativo ? 'true' : 'false');
        t.tabIndex = ativo ? 0 : -1;
        if (paineis[j]) paineis[j].hidden = !ativo;
      });
      if (focar) tabs[i].focus();
      if (url && tabs[i].dataset.versao) history.replaceState(null, '', '#' + tabs[i].dataset.versao);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => mostrar(i, false));
      t.addEventListener('keydown', (e) => {
        const passo = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (passo) { e.preventDefault(); mostrar((i + passo + tabs.length) % tabs.length); }
        if (e.key === 'Home') { e.preventDefault(); mostrar(0); }
        if (e.key === 'End') { e.preventDefault(); mostrar(tabs.length - 1); }
      });
    });
    /* Link direto de anúncio: /bikes/summa#xcr abre na XCR. */
    const alvo = decodeURIComponent(location.hash.replace('#', ''));
    const k = tabs.findIndex((t) => t.dataset.versao === alvo);
    if (k > 0) mostrar(k, false, false);
  });

  document.querySelectorAll('[data-abre-ficha]').forEach((b) => {
    b.addEventListener('click', () => {
      const d = document.getElementById(b.getAttribute('data-abre-ficha') || '');
      if (d instanceof HTMLDialogElement) d.showModal();
    });
  });
  document.querySelectorAll('dialog.ficha-modal').forEach((d) => {
    d.querySelector('[data-fecha-ficha]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>
