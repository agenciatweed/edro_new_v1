---
/* "Autonomia real, não de tabela": a autonomia da HORIZON é comunicada pelo simulador, nunca por tabela (v3.1, capítulo 2). */
import Cabecalho from './Cabecalho.astro';
import Midia from './Midia.astro';
import hz from '../content/horizon.json';
const s = hz.sistema.simulador;
---
<section class="secao">
  <div class="container">
    <Cabecalho linhas={['Autonomia real,', 'não de']} verde=" tabela."
      lead={`Na EDRO não trazemos informação de catálogo. Trazemos dados reais, testados e comprovados. Para isso criamos um simulador: você coloca a sua rota real e ele considera trajeto, elevações, peso do ciclista, potência, cadência, vento, temperatura e as demais variáveis para entregar a autonomia da bike com margem de erro de ${s.erro_pct}%.`} />
    <div class="autonomia">
      <div class="autonomia__cards">
        <div class="tec tec--destaque"><p class="numero-card__topo"><span class="numero-card__num">{s.erro_pct}</span><span class="numero-card__leg">%</span></p><p>Margem de erro do simulador contra pedais reais medidos.</p></div>
        <div class="tec"><p class="numero-card__topo"><span class="numero-card__num numero-card__num--branco">15+</span></p><p>Pedais instrumentados para calibrar o modelo, com máxima confiabilidade nas informações.</p></div>
        <div class="tec"><p class="numero-card__topo"><span class="numero-card__num numero-card__num--branco">GPX</span></p><p>Aceita GPX, TCX e FIT: a rota do seu Strava ou do seu Garmin.</p></div>
        <div class="tec"><p class="numero-card__topo"><span class="numero-card__num numero-card__num--branco">Vento</span></p><p>Previsão de vento e temperatura do local, por trecho, na data do seu pedal.</p></div>
      </div>
      <div>
        <Midia tipo="IMAGEM" titulo="Tela do simulador" descricao="Captura real do simulador (aba Rota Real) com um resultado, como convite para a página do simulador." proporcao="4x3" />
        <a class="btn btn--primario" href="/horizon/simulador">Simular a minha autonomia<svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
    </div>
  </div>
</section>
