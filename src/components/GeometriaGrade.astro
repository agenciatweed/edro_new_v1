---
/* =============================================================
   Geometria em grade (v3.3 §5.5 · referencias/ref-geometria-grade.png).
   À esquerda, o desenho cotado; à direita, o seletor de tamanho (com a
   faixa de altura do ciclista, quando existe) e a grade com todas as
   medidas do tamanho escolhido. "Ver tabela completa" abre a tabela de
   todos os tamanhos. Sem JavaScript, a grade mostra o M.
   ============================================================= */
import { Image } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { medida } from '../lib/edro.js';

const { p, id = 'geometria' } = Astro.props;
const geo = p.geometria;

const NOMES_EXTRA = { REACH: 'Reach', STACK: 'Stack', WB: 'Entre-eixos' };
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const colunas = geo.colunas
  .map((c, i) => {
    const leg = geo.legenda?.[c];
    if (leg && leg !== 'não publicar') return { codigo: c, indice: i, rotulo: cap(leg) };
    if (!leg && NOMES_EXTRA[c]) return { codigo: c, indice: i, rotulo: NOMES_EXTRA[c], semCodigo: true };
    return null;
  })
  .filter(Boolean);
const ORDEM = ['Reach', 'Stack', 'Ângulo da caixa', 'Ângulo do tubo de selim', 'Chainstay', 'Entre-eixos', 'Comprimento da caixa', 'BB drop'];
const pos = (r) => (ORDEM.indexOf(r) === -1 ? 99 : ORDEM.indexOf(r));
colunas.sort((a, b) => pos(a.rotulo) - pos(b.rotulo));

const tamanhos = p.tamanhos.filter((t) => Array.isArray(geo[t]));
const inicial = tamanhos.includes('M') ? 'M' : tamanhos[0];
/* Número vira medida em mm com vírgula decimal; ângulo já chega com o grau. */
const valor = (v) => (typeof v === 'number' ? `${medida(v)} mm` : String(v).replace(/(\d)\.(\d)/, '$1,$2'));
/* Faixa de altura do ciclista por tamanho (bikes.json → alturaCiclista), quando existe. */
const m2 = (n) => n.toFixed(2).replace('.', ',');
const altura = Object.fromEntries((p.alturaCiclista?.faixas ?? []).map((f) => [f.tamanho, `${m2(f.min)} a ${m2(f.max)} m`]));
const faixa = (t) => altura[t] ?? null;
const dados = colunas.map((c) => Object.fromEntries(tamanhos.map((t) => [t, valor(geo[t][c.indice])])));
---
<section class="secao geo-grade" id={id} data-geo-grade>
  <div class="container">
    <h2 class="headline">Geometria.</h2>
    <p class="lead geo-grade__lead">O FIT4U define o tamanho certo para você e ajusta avanço, largura de guidão e alturas dentro dele.</p>
    <div class="geo-grade__corpo">
      <figure class="geo-grade__desenho">
        <Image src={img(`geometria/geo-${p.slug}-escuro.png`)} alt={`Desenho cotado do quadro EDRO ${p.nome} com os códigos das medidas`} width={1100} loading="lazy" />
      </figure>
      <div>
        <div class="geo-grade__tamanhos" role="radiogroup" aria-label={`Tamanho do quadro da ${p.nome}`}>
          {tamanhos.map((t) => (
            <button type="button" role="radio" class="geo-grade__tamanho" aria-checked={t === inicial ? 'true' : 'false'} tabindex={t === inicial ? 0 : -1} data-tamanho={t}>
              <b>{t}</b>
              {faixa(t) && <span>{faixa(t)}</span>}
            </button>
          ))}
        </div>
        <dl class="geo-grade__grade" aria-live="polite">
          {colunas.map((c, i) => (
            <div class="geo-grade__celula">
              <dt>{!c.semCodigo && <span class="geo-grade__codigo">{c.codigo}</span>}{c.rotulo}</dt>
              <dd data-valores={JSON.stringify(dados[i])}>{dados[i][inicial]}</dd>
            </div>
          ))}
        </dl>
        <p class="caption geo-grade__nota">Tamanho <b data-tamanho-atual>{inicial}</b>{altura[inicial] ? ', ' : ''}<span data-altura-atual>{altura[inicial] ? `para ciclistas de ${faixa(inicial)}` : ''}</span>. Faixas de altura indicativas; o FIT4U confirma o tamanho pelas suas medidas.</p>
        <button type="button" class="geo-grade__tabela-link" data-abre-ficha={`${id}-tabela`}>Ver tabela completa de geometria</button>
      </div>
    </div>
  </div>

  <dialog class="ficha-modal" id={`${id}-tabela`} aria-labelledby={`${id}-tabela-t`}>
    <div class="ficha-modal__topo">
      <h2 class="card-title" id={`${id}-tabela-t`}>Geometria <i class="modelo">{p.nome}</i></h2>
      <button class="ficha-modal__fechar" type="button" data-fecha-ficha aria-label="Fechar tabela de geometria">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="ficha-modal__corpo">
      <div class="tabela-rolagem">
        <table class="tabela tabela--geometria">
          <caption class="visualmente-oculto">Geometria da {p.nome}, tamanhos {tamanhos.join(', ')}</caption>
          <thead><tr><th scope="col">Medida</th>{tamanhos.map((t) => <th scope="col">{t}</th>)}</tr></thead>
          <tbody>
            {colunas.map((c, i) => (
              <tr><th scope="row">{c.semCodigo ? '' : `${c.codigo} · `}{c.rotulo}</th>{tamanhos.map((t) => <td>{dados[i][t]}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-geo-grade]').forEach((s) => {
    const botoes = [...s.querySelectorAll<HTMLButtonElement>('[data-tamanho]')];
    const celulas = [...s.querySelectorAll<HTMLElement>('[data-valores]')];
    const atual = s.querySelector('[data-tamanho-atual]');
    const alturaEl = s.querySelector('[data-altura-atual]');
    const alturas = Object.fromEntries(botoes.map((b) => [b.dataset.tamanho, b.querySelector('span')?.textContent ?? '']));
    const escolher = (i: number, focar = false) => {
      const t = botoes[i].dataset.tamanho!;
      botoes.forEach((b, j) => { b.setAttribute('aria-checked', String(i === j)); b.tabIndex = i === j ? 0 : -1; });
      celulas.forEach((c) => { c.textContent = JSON.parse(c.dataset.valores!)[t]; });
      if (atual) atual.textContent = t;
      if (alturaEl) alturaEl.textContent = alturas[t] ? `para ciclistas de ${alturas[t]}` : '';
      if (focar) botoes[i].focus();
    };
    botoes.forEach((b, i) => {
      b.addEventListener('click', () => escolher(i));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (d) { e.preventDefault(); escolher((i + d + botoes.length) % botoes.length, true); }
      });
    });
    s.querySelectorAll<HTMLElement>('[data-abre-ficha]').forEach((b) => b.addEventListener('click', () => {
      const d = document.getElementById(b.dataset.abreFicha || '');
      if (d instanceof HTMLDialogElement) d.showModal();
    }));
    s.querySelectorAll('dialog').forEach((d) => {
      d.querySelector('[data-fecha-ficha]')?.addEventListener('click', () => d.close());
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    });
  });
</script>
