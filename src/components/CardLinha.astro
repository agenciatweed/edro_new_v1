---
/* Card de linha de bikes (home e /bikes), v3.2. Nome da linha em wordmark,
   foto lateral oficial da PRO, a frase "para quem" do catálogo 2027,
   peso da PRO e o preço de entrada. */
import { Picture, Image } from 'astro:assets';
import { img } from '../lib/imagens.js';
import { brl, pesoTexto } from '../lib/edro.js';

const { p, larga = false } = Astro.props;
---
<article class:list={['card-linha', { 'card-linha--larga': larga }]}>
  <p class="eyebrow">{p.tipo}</p>
  <h3 class="card-linha__wordmark">
    <a class="card-linha__link" href={`/bikes/${p.slug}`}>
      <Image src={img(`brand/${p.slug}.png`)} alt={p.nome} height={60} />
    </a>
  </h3>
  <span class="card-linha__canto" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg></span>
  <span class="card-linha__render">
    <Picture src={img(p.pro.foto)} formats={['avif', 'webp']} alt={`EDRO ${p.nome} ${p.pro.nome} 2027, vista lateral`}
      widths={[800, 1600]} sizes={larga ? '(max-width: 767px) 100vw, 440px' : '(max-width: 767px) 100vw, 33vw'} loading="lazy" />
  </span>
  <p class="card-linha__beneficio">{p.para_quem}.</p>
  <div class="card-linha__numeros">
    <div>
      <p class="card-linha__valor">{pesoTexto(p.pro)}&nbsp;<small>kg</small></p>
      <span class="caption">{p.pro.nome}, sem pedais</span>
    </div>
    <div>
      <p class="card-linha__valor"><small>a partir de</small> {brl(p.entrada.preco)}</p>
      <span class="caption">{p.versoes.map((v) => v.nome).join(', ')}, {p.entrada.parcelamento}</span>
    </div>
  </div>
  {larga && (
    <dl class="card-linha__macro">
      {p.macro_specs.map(([rot, val]) => (<div><dt>{rot}</dt><dd>{val}</dd></div>))}
    </dl>
  )}
  <span class="card-linha__cta">Conhecer a <i class="modelo">{p.nome}</i> <span aria-hidden="true">→</span></span>
</article>
